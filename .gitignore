# Raw per-profile API cache — large, regenerable, and only used to make
# re-runs resumable. The CSV/XLSX in data/ are the actual deliverables.
data/listing_details.cache.jsonl

# Output of find_acquisition_conversations.py: contains excerpts of confidential
# M&A discussions pulled from CRM engagement records. Regenerable on demand;
# deliberately not committed.
data/acquisition_conversations.csv

# ZoomInfo resume caches. These exist so an interrupted sourcing run never
# re-buys a contact it already paid for; large, and not a deliverable.
data/zi_search.cache.jsonl
data/zi_enrich.cache.jsonl

# Working output of load_ma_contacts_to_hubspot.py - regenerated on every run.
data/ma_load_preview.csv
data/ma_load_rejects.csv

# Raw scraper output, rewritten in place on every run and streamed to during a
# ~20 minute pass, so a commit mid-run captures a truncated file. Names in here
# still need a verification pass; commit a reviewed extract, not this.
data/partner_leadership_scraped.csv

# Audit output: every CRM contact whose email domain belongs to a partner, with
# their address. Third-party personal data, regenerable in one command, and it
# has no business in version control.
data/partner_contact_audit.csv

# Local venv, only needed because the system cryptography install is broken.
.venv-zi/

__pycache__/
*.pyc
.DS_Store
