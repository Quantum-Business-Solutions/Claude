# Enables live-site ingest: reads real design tokens (colors, fonts, sizes,
# radii, component specs) off a URL via Firecrawl's `branding` extractor.
# This is the preferred way to add references. Get a key at firecrawl.dev.
FIRECRAWL_API_KEY=

# Optional fallback — only used for uploaded screenshots, where vocabulary has
# to be inferred from the image rather than measured off a live page.
ANTHROPIC_API_KEY=
