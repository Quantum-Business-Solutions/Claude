{"archivedAt":"1970-01-01T00:00:00Z","archivedInDashboard":false,"attachedStylesheets":[],"authorName":"Shawn Peterson","categoryId":1,"contentTypeCategory":4,"createdAt":"2026-06-30T18:02:17.655Z","createdById":"26261533","currentState":"DRAFT","domain":"info.davincilabs.com","featuredImage":"","featuredImageAltText":"","htmlTitle":"Private Label Heart Health Supplements | DaVinci Private Label","id":"216189433373","language":"en","layoutSections":{},"metaDescription":"Private label heart health supplements. Omega-3, CoQ10, ubiquinol, BP support, fiber + plant sterols. Doctor-recommended cardiovascular formulations.","name":"Private Label - Page - Heart Health Supplements","pageRedirected":false,"publicAccessRules":[],"publicAccessRulesEnabled":false,"publishDate":"1970-01-01T00:00:00Z","published":false,"slug":"pl-demo-heart-health","state":"DRAFT","subcategory":"site_page","templatePath":"Private Label/Templates/Page.html","translations":{},"updatedAt":"2026-06-30T20:11:34.359Z","updatedById":"26261533","url":"https://info.davincilabs.com/pl-demo-heart-health","useFeaturedImage":false,"widgetContainers":{"main_content":{"widgets":[{"body":{"html":"<div style=\"background: linear-gradient(rgba(201,219,226,.85), rgba(201,219,226,.85)), url('https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_HeroBackground_2.jpg') center/cover; padding: 90px 20px; text-align: center;\">\n  <div style=\"max-width: 900px; margin: 0 auto;\">\n    <p style=\"color: #012638; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 14px;\">PRIVATE LABEL HEART HEALTH SUPPLEMENTS</p>\n    <h1 style=\"color: #012638; font-size: 48px; font-weight: 700; line-height: 1.15; margin: 0 0 22px;\">Cardiovascular support formulations using omega-3s, CoQ10, and clinically supported ingredients.</h1>\n    <p style=\"color: #012638; font-size: 19px; line-height: 1.5; margin: 0 0 34px;\">Heart Health supplements are one of the most consistently in-demand categories in the wellness market. Customers actively search for trusted brands in this space, and demand spans every age and demographic.</p>\n    <a href=\"#get-started\" style=\"display: inline-block; background: #6BA644; color: white; padding: 16px 38px; text-decoration: none; font-size: 16px; font-weight: 700; border-radius: 4px; letter-spacing: .5px;\">Talk to Our Team</a>\n  </div>\n</div>"},"id":216201609130,"type":"rich_text"},{"body":{"html":"<div style=\"max-width: 850px; margin: 0 auto; padding: 80px 20px 50px;\">\n  <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; line-height: 1.25; margin: 0 0 26px;\">Build a heart health supplement line with proven formulations.</h2>\n  <p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">Heart health is one of the most credibility-driven supplement categories. Customers (and their cardiologists) want clinical-grade ingredients backed by research. DaVinci's cardiovascular formulations meet that bar.</p><p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">With direct access to over 250 doctor-formulated supplements, low minimums, and no set-up fees, you can build out a complete product line that fits your audience. Choose from our catalog of ready-to-launch formulations, customize the branding, and we handle manufacturing and fulfillment.</p>\n</div>"},"id":216201609131,"type":"rich_text"},{"body":{"html":"<div style=\"background: #c9dbe2; padding: 70px 20px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; text-align: center; margin: 0 0 14px;\">HOW IT WORKS</p>\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 50px; line-height: 1.2;\">Get to market faster with a partner who handles the heavy lifting.</h2>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 40px;\">\n  