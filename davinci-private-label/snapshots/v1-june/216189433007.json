{"archivedAt":"1970-01-01T00:00:00Z","archivedInDashboard":false,"attachedStylesheets":[],"authorName":"Shawn Peterson","categoryId":1,"contentTypeCategory":4,"createdAt":"2026-06-30T17:55:20.431Z","createdById":"26261533","currentState":"DRAFT","domain":"info.davincilabs.com","featuredImage":"","featuredImageAltText":"","htmlTitle":"Private Label Sleep Supplements | DaVinci Private Label","id":"216189433007","language":"en","layoutSections":{},"metaDescription":"Private label sleep supplements with melatonin, L-theanine, ashwagandha and valerian. Capsule, chewable and liquid formats. Doctor-formulated.","name":"Private Label - Page - Sleep Supplements","pageRedirected":false,"publicAccessRules":[],"publicAccessRulesEnabled":false,"publishDate":"1970-01-01T00:00:00Z","published":false,"slug":"pl-demo-sleep","state":"DRAFT","subcategory":"site_page","templatePath":"Private Label/Templates/Page.html","translations":{},"updatedAt":"2026-06-30T20:16:41.559Z","updatedById":"26261533","url":"https://info.davincilabs.com/pl-demo-sleep","useFeaturedImage":false,"widgetContainers":{"main_content":{"widgets":[{"body":{"html":"<div style=\"background: linear-gradient(rgba(201,219,226,.85), rgba(201,219,226,.85)), url('https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/sleepsupps.png') center/cover; padding: 90px 20px; text-align: center;\">\n  <div style=\"max-width: 900px; margin: 0 auto;\">\n    <p style=\"color: #012638; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 14px;\">PRIVATE LABEL SLEEP SUPPLEMENTS</p>\n    <h1 style=\"color: #012638; font-size: 48px; font-weight: 700; line-height: 1.15; margin: 0 0 22px;\">Sleep supplements that promote restful sleep and support natural sleep cycles.</h1>\n    <p style=\"color: #012638; font-size: 19px; line-height: 1.5; margin: 0 0 34px;\">In an ideal world, everyone would fall asleep within minutes and get plenty of rest every night. In reality, millions of Americans struggle to get adequate, high-quality sleep. Sleep supplements promote restful sleep by helping reduce everyday stress and supporting the body's natural sleep cycle.</p>\n    <a href=\"#get-started\" style=\"display: inline-block; background: #6BA644; color: white; padding: 16px 38px; text-decoration: none; font-size: 16px; font-weight: 700; border-radius: 4px; letter-spacing: .5px;\">Talk to Our Team</a>\n  </div>\n</div>"},"id":216201609510,"type":"rich_text"},{"body":{"html":"<div style=\"max-width: 850px; margin: 0 auto; padding: 80px 20px 50px;\">\n  <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; line-height: 1.25; margin: 0 0 26px;\">Build a sleep supplement line with proven formulations.</h2>\n  <p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">Sleep customers are not just people with persistent sleep difficulties. They include travelers managing jet lag, parents handling everyday stress, professionals trying to optimize daytime focus, and anyone wanting deeper and more consistent sleep. The category appeals across audiences.</p><p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">With direct access to over 250 doctor-formulated supplements, low minimums, and no set-up fees, you can build out a complete product line that fits your audience. Choose from our catalog of ready-to-launch formulations, customize the branding, and we handle manufacturing and fulfillment.</p>\n</div>"},"id":216201609511,"type":"rich_text"},{"body":{"html":"<div style=\"background: #c9dbe2; padding: 70px 20px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; text-align: center; margin: 0 0 14px;\">HOW IT WORKS</p>\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 50px; line-height: 1.2;\">Get to market faster with a partner who handles the heavy lifting.</h2>\n    <div style=\"display: 