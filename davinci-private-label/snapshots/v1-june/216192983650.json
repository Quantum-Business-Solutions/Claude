{"archivedAt":"1970-01-01T00:00:00Z","archivedInDashboard":false,"attachedStylesheets":[],"authorName":"Shawn Peterson","categoryId":1,"contentTypeCategory":4,"createdAt":"2026-06-30T18:12:37.729Z","createdById":"26261533","currentState":"DRAFT","domain":"info.davincilabs.com","featuredImage":"","featuredImageAltText":"","htmlTitle":"Contact DaVinci Private Label | DaVinci Private Label","id":"216192983650","language":"en","layoutSections":{},"metaDescription":"Get in touch with our private label supplement team. Response within one business day.","name":"Private Label - Page - Contact","pageRedirected":false,"publicAccessRules":[],"publicAccessRulesEnabled":false,"publishDate":"1970-01-01T00:00:00Z","published":false,"slug":"pl-demo-contact","state":"DRAFT","subcategory":"site_page","templatePath":"Private Label/Templates/Page.html","translations":{},"updatedAt":"2026-06-30T20:13:08.192Z","updatedById":"26261533","url":"https://info.davincilabs.com/pl-demo-contact","useFeaturedImage":false,"widgetContainers":{"main_content":{"widgets":[{"body":{"html":"<div style=\"background: linear-gradient(rgba(201,219,226,.85), rgba(201,219,226,.85)), url('https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_HeroBackground_2.jpg') center/cover; padding: 90px 20px; text-align: center;\">\n  <div style=\"max-width: 900px; margin: 0 auto;\">\n    <p style=\"color: #012638; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 14px;\">CONTACT</p>\n    <h1 style=\"color: #012638; font-size: 48px; font-weight: 700; line-height: 1.15; margin: 0 0 22px;\">Get in touch with our private label team.</h1>\n    <p style=\"color: #012638; font-size: 19px; line-height: 1.5; margin: 0 0 34px;\">Questions about private label supplements, custom formulation, or specific products in our catalog? Reach out and we will get back to you within one business day.</p>\n    <a href=\"#get-started\" style=\"display: inline-block; background: #6BA644; color: white; padding: 16px 38px; text-decoration: none; font-size: 16px; font-weight: 700; border-radius: 4px; letter-spacing: .5px;\">Send a Message</a>\n  </div>\n</div>"},"id":216201609351,"type":"rich_text"},{"body":{"html":"<div style=\"max-width: 850px; margin: 0 auto; padding: 80px 20px 50px;\">\n  <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; line-height: 1.25; margin: 0 0 26px;\">How to reach us.</h2>\n  <p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">[PLACEHOLDER FOR JUSTIN: HubSpot contact form embed here. Phone, email, and physical address details below should be confirmed with Patrick.]</p>\n</div>"},"id":216201609352,"type":"rich_text"},{"body":{"html":"<div style=\"background: #f7f7f6; padding: 20px 20px 70px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px;\">\n      <div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.24a2.25 2.25 0 0 1-1.07 1.92l-7.5 4.62a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.92v-.24\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Email</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">[Placeholder] privatelabel@davincilabs.com, Response within one business day.</p>\n    </div><div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M10.34 3.94c.36-1.84 2.95-1.83 3.3 0l.32 1.62a14.96 14.96 0 0 0 6.1 1.87 2.25 2.25 0 0 1 1.94 2.23v4.66a2.25 2.25 0 0 1-1.94 2.23 14.96 14.96 0 0 0-6.1 1.87l-.32 1.62c-.36 1.83-2.95 1.83-3.3 0l-.33-1.62a14.96 14.96 0 0 0-6.1-1.87 2.25 2.25 0 0 1-1.94-2.23V9.66a2.25 2.25 0 0 1 1.94-2.23 14.96 14.96 0 0 0 6.1-1.87l.33-1.62Z\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Phone</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">[Placeholder] 1-800-325-1776, Mon-Fri 8am-5pm Eastern.</p>\n    </div><div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z\"/><path d=\"M19.5 10.5c0 7.14-7.5 11.25-7.5 11.25S4.5 17.64 4.5 10.5a7.5 7.5 0 1 1 15 0Z\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Mailing address</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">DaVinci Laboratories of Vermont, 929 Harvest Lane, Williston, VT 05495</p>\n    </div>\n    </div>\n  </div>\n</div>"},"id":216201609353,"type":"rich_text"},{"body":{"html":"<div style=\"background-color: #f7f7f6; padding: 80px 24px;\">\n  <div style=\"max-width: 720px; margin: 0 auto;\">\n    \n        <div style=\"text-align: center; margin-bottom: 32px;\">\n          <h2 style=\"color: #012638; font-size: 36px; line-height: 1.2; margin: 0 0 16px 0; font-weight: 700;\">Get in touch</h2>\n          <p style=\"color: #012638; opacity: 0.85; font-size: 18px; line-height: 1.6; max-width: 720px; margin: 0 auto;\">Send us a message and we will reply within one business day.</p></div>\n    <div style=\"background: #FFFFFF; padding: 40px; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);\">\n      <div id=\"hsform_8361c2ac468c\"></div>\n      <script charset=\"utf-8\" type=\"text/javascript\" src=\"//js.hsforms.net/forms/embed/v2.js\"></script>\n      <script>\n        if (window.hbspt) {\n          hbspt.forms.create({\n            portalId: \"4087538\",\n            formId: \"8361c2ac-468c-4d5a-8bad-07cd8909c840\",\n            target: \"#hsform_8361c2ac468c\"\n          });\n        }\n      </script>\n    </div>\n  </div>\n</div>"},"id":216201609354,"type":"rich_text"},{"body":{"html":"<div id=\"get-started\" style=\"background: #e6e5e3; padding: 80px 20px; text-align: center;\">\n  <div style=\"max-width: 720px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; line-height: 1.25; margin: 0 0 16px;\">Ready to launch your private label supplement line?</h2>\n    <p style=\"color: #333; font-size: 17px; line-height: 1.55; margin: 0 0 32px;\">Schedule a consultation. We will walk through your audience, the right formulations for them, branding options, and the timeline.</p>\n    <a href=\"#get-started\" style=\"display: inline-block; background: #6BA644; color: white; padding: 16px 40px; text-decoration: none; font-size: 16px; font-weight: 700; border-radius: 4px; letter-spacing: .5px;\">Schedule a Consultation</a>\n  </div>\n</div>"},"id":216201609355,"type":"rich_text"},{"body":{"html":"<div style=\"background: white; padding: 90px 20px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1.2fr; gap: 56px; align-items: center;\">\n    <div>\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/Private%20Label%20Guide%20ToF.jpg\" alt=\"The Definitive Guide to Private Labeling Supplements\" style=\"width: 100%; height: auto; border-radius: 8px; box-shadow: 0 8px 30px rgba(1,38,56,.15);\"/>\n    </div>\n    <div>\n      <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 14px;\">NEW TO PRIVATE LABEL</p>\n      <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; line-height: 1.2; margin: 0 0 20px;\">Get the free Definitive Guide to Private Labeling</h2>\n      <p style=\"color: #333; font-size: 16px; line-height: 1.65; margin: 0 0 28px;\">If you are new to private labeling supplements and want to learn more about how to build your brand with our manufacturing team, download our free Definitive Guide. You will get answers to the most frequently asked questions about private labeling, plus tips and step-by-step instructions to make your new product launch easy, successful, and profitable.</p>\n      <a href=\"/guide-definitive-private-label\" style=\"display: inline-block; background: #6BA644; color: white; padding: 14px 32px; text-decoration: none; font-size: 15px; font-weight: 700; border-radius: 4px; letter-spacing: .5px;\">Download the Guide</a>\n    </div>\n  </div>\n</div>"},"id":216201609356,"type":"rich_text"},{"body":{"html":"<div style=\"background: #e6e5e3; padding: 90px 20px;\">\n  <div style=\"max-width: 900px; margin: 0 auto; text-align: center;\">\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 14px;\">50+ YEARS OF SUPPLEMENT MANUFACTURING</p>\n    <h2 style=\"color: #012638; font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0 0 24px;\">Developed by us. Made for you.</h2>\n    <p style=\"color: #333; font-size: 17px; line-height: 1.65; margin: 0 0 18px;\">With over 50 years in the health supplement industry, we are one of the most trusted dietary supplement manufacturers. Every private label supplement we produce is doctor-formulated using thoroughly researched ingredients, then scientifically reviewed for efficacy and quality before it ever enters production in our U.S. facilities.</p>\n    <p style=\"color: #333; font-size: 17px; line-height: 1.65; margin: 0 0 18px;\">FoodScience is an FDA-registered food facility, GMP certified to SQF food safety standards, and certified to NSF GMP 455-2.</p>\n    <p style=\"color: #333; font-size: 17px; line-height: 1.65; margin: 0 0 40px;\">When you partner with us, our expert team is with you every step of the way. Help your customers find what they want from a source they trust. You.</p>\n    <div style=\"display: flex; gap: 50px; justify-content: center; align-items: center; flex-wrap: wrap;\">\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_Logo_SQF.png\" alt=\"SQF Certified\" style=\"height: 80px; width: auto;\"/>\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/NSF.png\" alt=\"NSF GMP Certified\" style=\"height: 80px; width: auto;\"/>\n    </div>\n  </div>\n</div>"},"id":216201609357,"type":"rich_text"},{"body":{"html":"<div style=\"background: #f7f7f6; padding: 80px 20px;\">\n  <div style=\"max-width: 820px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 16px;\">Frequently asked questions</h2>\n    <p style=\"color: #555; font-size: 17px; text-align: center; margin: 0 0 44px;\">None</p>\n    <details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>What's the fastest way to get a response?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Use the contact form on this page. It routes directly to the team and is checked multiple times per business day. Phone calls are also available. Email to info@davincilabs.com works but is slightly slower than the form.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>What if I have an urgent issue with an existing order?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Contact your account manager directly. If you don't have an account manager assigned yet, mention 'urgent existing order' in your form submission and we'll route appropriately. Production and quality issues are prioritized.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>What hours are you available?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Business hours are Monday-Friday, 8am-5pm Eastern. Most messages submitted outside hours get a response the next business morning. We don't run 24/7 support, but we do respond promptly to legitimate urgent issues.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Is there a physical address I can visit?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Yes. Our facility is at 929 Harvest Lane, Williston, VT 05495. We host facility tours by appointment. Drop-in visits are not supported because manufacturing facilities have access protocols, but scheduled visits are encouraged.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Can I call instead of emailing?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Yes. Phone is welcome during business hours. The contact form is faster for non-urgent matters because it routes to the right person automatically. For complex conversations (scoping a new project, troubleshooting an order), a scheduled call works better than email back-and-forth.</div>\n    </details>\n  </div>\n</div>"},"id":216201609358,"type":"rich_text"},{"body":{"html":"<div style=\"background: #012638; padding: 28px 24px; border-top: 1px solid rgba(255,255,255,.12);\">\n  <div style=\"max-width: 1100px; margin: 0 auto; text-align: center;\">\n    <p style=\"color: rgba(255,255,255,.78); font-size: 12px; line-height: 1.6; margin: 0; letter-spacing: .2px;\">\n      These statements have not been evaluated by the Food and Drug Administration. These products are not intended to diagnose, treat, cure, or prevent any disease. Information on this site is provided for informational purposes only and is not intended as a substitute for advice from your physician or other health care professional.\n    </p>\n  </div>\n</div>"},"id":216201609359,"type":"rich_text"}]}},"widgets":{}}