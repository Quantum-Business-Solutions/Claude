     "type": "rich_text"
    },
    {
     "body": {
      "html": "<div style=\"background: #f7f7f6; padding: 80px 20px;\">\n  <div style=\"max-width: 1200px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 16px;\">Build across multiple health categories</h2>\n    <p style=\"color: #555; font-size: 17px; text-align: center; max-width: 760px; margin: 0 auto 48px;\">Most brands start with one category and expand. Combine men's health with adjacent categories to grow lifetime value per customer.</p>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px;\">\n      <a href=\"/pl-demo-fitness\" style=\"display: block; text-decoration: none;\">\n      <div style=\"background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(1,38,56,.08);\">\n        <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/fitnesssupps.png\" alt=\"Fitness\" style=\"width: 100%; height: 160px; object-fit: cover; display: block;\"/>\n        <div style=\"padding: 18px 20px; text-align: center;\">\n          <p style=\"color: #012638; font-size: 17px; font-weight: 700; margin: 0;\">Fitness</p>\n        </div>\n      </div>\n    </a><a href=\"/pl-demo-herbal\" style=\"display: block; text-decoration: none;\">\n      <div style=\"background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(1,38,56,.08);\">\n        <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/herbalsupps.png\" alt=\"Herbal\" style=\"width: 100%; height: 160px; object-fit: cover; display: block;\"/>\n        <div style=\"padding: 18px 20px; text-align: center;\">\n          <p style=\"color: #012638; font-size: 17px; font-weight: 700; margin: 0;\">Herbal</p>\n        </div>\n      </div>\n    </a><a href=\"/pl-demo-aging\" style=\"display: block; text-decoration: none;\">\n      <div style=\"background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(1,38,56,.08);\">\n        <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/agingsupps.png\" alt=\"Aging\" style=\"width: 100%; height: 160px; object-fit: cover; display: block;\"/>\n        <div style=\"padding: 18px 20px; text-align: center;\">\n          <p style=\"color: #012638; font-size: 17px; font-weight: 700; margin: 0;\">Aging</p>\n        </div>\n      </div>\n    </a><a href=\"/pl-demo-sleep\" style=\"display: block; text-decoration: none;\">\n      <div style=\"background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(1,38,56,.08);\">\n        <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/sleepsupps.png\" alt=\"Sleep\" style=\"width: 100%; height: 160px; object-fit: cover; display: block;\"/>\n        <div style=\"padding: 18px 20px; text-align: center;\">\n          <p style=\"color: #012638; font-size: 17px; font-weight: 700; margin: 0;\">Sleep</p>\n        </div>\n      </div>\n    </a><a href=\"/pl-demo-womens-health\" style=\"display: block; text-decoration: none;\">\n      <div style=\"background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(1,38,56,.08);\">\n        <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/womenssupps.png\" alt=\"Women's Health\" style=\"width: 100%; height: 160px; object-fit: cover; display: block;\"/>\n        <div style=\"padding: 18px 20px; text-align: center;\">\n          <p style=\"color: #012638; font-size: 17px; font-weight: 700; margin: 0;\">Women's Health</p>\n        </div>\n      </div>\n    </a><a href=\"/pl-demo-probiotics\" style=\"display: block; text-decoration: none;\">\n      <div style=\"background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(1,38,56,.08);\">\n        <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/probioticsupps.png\" alt=\"Probiotics\" style=\"width: 100%; height: 160px; object-fit: cover; display: block;\"/>\n        <div style=\"padding: 18px 20px; text-align: center;\">\n          <p style=\"color: #012638; font-size: 17px; font-weight: 700; margin: 0;\">Probiotics</p>\n        </div>\n      </div>\n    </a>\n    </div>\n  </div>\n</div>"
     },
