     "body": {
      "html": "<div style=\"background: white; padding: 80px 20px;\">\n  <div style=\"max-width: 1200px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 16px;\">Our aging formulations available for private label</h2>\n    <p style=\"color: #555; font-size: 18px; text-align: center; max-width: 760px; margin: 0 auto 48px;\">A selection of our existing aging supplement line, available for private label today. Schedule a consultation for the full catalog and custom options.</p>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;\">\n      <div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M3.75 13.5 13.5 3l-2.25 7.5h6L9 21l2.25-7.5h-7.5Z\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 8px;\">CELLULAR</p>\n      <h3 style=\"color: #012638; font-size: 18px; font-weight: 700; margin: 0 0 8px;\">NAD+ ACTIVATE</h3>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0 0 16px;\">Nicotinamide ascorbate with Bioenergy Ribose for enhanced NAD+ cellular energy absorption.</p>\n      <div><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">NAD+</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Vitamin B3</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">D-Ribose</span></div>\n    </div><div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M9 12.75 11.25 15 15 9.75M21 12c0 5.31-3.69 9.76-8.65 10.95a.84.84 0 0 1-.4.05.94.94 0 0 1-.41-.05A11.25 11.25 0 0 1 3 12V5.99c0-.46.31-.87.74-1.05A23.95 23.95 0 0 1 12 3a23.95 23.95 0 0 1 8.26 1.94c.43.18.74.59.74 1.05V12Z\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 8px;\">LONGEVITY</p>\n      <h3 style=\"color: #012638; font-size: 18px; font-weight: 700; margin: 0 0 8px;\">Telomere Benefits\u2122</h3>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0 0 16px;\">Targeted formulation supporting telomere health and cellular longevity.</p>\n      <div><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Telomere Support</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Longevity</span></div>\n    </div><div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M8.59 12.41a6 6 0 0 1 8.49-8.49l-1.06 1.06m-4.94 11.42L8.59 12.41m6.36 6.36-3.32-3.32m-1.4-1.4a6 6 0 0 0-3.74 1.43A6 6 0 0 0 4 21l1.5-1.5m11.13-11.13L21 4\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 8px;\">BOTANICAL</p>\n      <h3 style=\"color: #012638; font-size: 18px; font-weight: 700; margin: 0 0 8px;\">Phyto Benefits\u2122</h3>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0 0 16px;\">Phytonutrient blend with antioxidant compounds for whole-body wellness.</p>\n      <div><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Phytonutrients</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Antioxidants</span></div>\n    </div><div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M9.81 4.94 9 2.25l-.81 2.69a4.5 4.5 0 0 1-3 3L2.5 8.75l2.69.81a4.5 4.5 0 0 1 3 3l.81 2.69.81-2.69a4.5 4.5 0 0 1 3-3l2.69-.81-2.69-.81a4.5 4.5 0 0 1-3-3ZM18 7.5l-.51 1.71a3 3 0 0 1-2.03 2.03L13.75 11.75l1.71.51a3 3 0 0 1 2.03 2.03L18 16l.51-1.71a3 3 0 0 1 2.03-2.03L22.25 11.75l-1.71-.51a3 3 0 0 1-2.03-2.03L18 7.5ZM16.5 18.75 16.04 20l-.46 1.25-.46-1.25-.46-1.25.46-1.25.46 1.25Z\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 8px;\">ANTIOXIDANT</p>\n      <h3 style=\"color: #012638; font-size: 18px; font-weight: 700; margin: 0 0 8px;\">Glutathione Bright</h3>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0 0 16px;\">Master antioxidant for cellular protection and detox support.</p>\n      <div><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Glutathione</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Antioxidant</span></div>\n    </div><div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M21 8.25c0-2.49-2.02-4.5-4.5-4.5-1.83 0-3.4 1.09-4.13 2.66A4.49 4.49 0 0 0 7.5 3.75 4.5 4.5 0 0 0 3 8.25c0 6.97 9 12 9 12s9-5.03 9-12Z\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 8px;\">SKIN & BEAUTY</p>\n      <h3 style=\"color: #012638; font-size: 18px; font-weight: 700; margin: 0 0 8px;\">Collagen Bright\u2122</h3>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0 0 16px;\">Collagen with supporting nutrients for skin elasticity and hair quality.</p>\n      <div><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Collagen</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Skin Support</span></div>\n    </div><div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M9.75 3.1v5.66m4.5-5.66v5.66m-4.5 0a3.38 3.38 0 0 1-1.5 6.43m6-6.43a3.38 3.38 0 0 0 1.5 6.43M4.5 19.5a4.5 4.5 0 0 0 4.5 4.5h6a4.5 4.5 0 0 0 4.5-4.5v-4.31a4.5 4.5 0 0 0-4.5-4.5h-6a4.5 4.5 0 0 0-4.5 4.5v4.31Z\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 8px;\">LIPOSOMAL</p>\n      <h3 style=\"color: #012638; font-size: 18px; font-weight: 700; margin: 0 0 8px;\">Liposomal DHEA</h3>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0 0 16px;\">Liquid liposomal format for optimal absorption of small DHEA molecules.</p>\n      <div><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">DHEA</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Liposomal</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Liquid</span></div>\n    </div><div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M9 12.75 11.25 15 15 9.75M21 12c0 5.31-3.69 9.76-8.65 10.95a.84.84 0 0 1-.4.05.94.94 0 0 1-.41-.05A11.25 11.25 0 0 1 3 12V5.99c0-.46.31-.87.74-1.05A23.95 23.95 0 0 1 12 3a23.95 23.95 0 0 1 8.26 1.94c.43.18.74.59.74 1.05V12Z\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 8px;\">FOUNDATION</p>\n      <h3 style=\"color: #012638; font-size: 18px; font-weight: 700; margin: 0 0 8px;\">Resveratrol, Quercetin, Curcumin</h3>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0 0 16px;\">Foundational polyphenol antioxidants for healthy aging support.</p>\n      <div><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Resveratrol</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Quercetin</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Curcumin</span></div>\n    </div><div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M8.59 12.41a6 6 0 0 1 8.49-8.49l-1.06 1.06m-4.94 11.42L8.59 12.41m6.36 6.36-3.32-3.32m-1.4-1.4a6 6 0 0 0-3.74 1.43A6 6 0 0 0 4 21l1.5-1.5m11.13-11.13L21 4\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 8px;\">OMEGAS</p>\n      <h3 style=\"color: #012638; font-size: 18px; font-weight: 700; margin: 0 0 8px;\">Omega 3, Vitamins A/D/K, Zinc</h3>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0 0 16px;\">Essential nutrients for cardiovascular, immune, and bone health as customers age.</p>\n      <div><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Omega 3</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">ADK</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Zinc</span></div>\n    </div>\n    </div>\n  </div>\n</div>"
     },
