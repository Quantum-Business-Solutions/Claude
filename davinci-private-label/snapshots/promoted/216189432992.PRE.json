    {
     "body": {
      "html": "<div style=\"background: white; padding: 70px 20px 0; text-align: center;\">\n  <div style=\"max-width: 900px; margin: 0 auto;\">\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 12px;\">OUR PRIVATE LABEL CATEGORIES</p>\n    <h2 style=\"color: #012638; font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0 0 16px;\">Browse all private label wellness categories</h2>\n    <p style=\"color: #555; font-size: 18px; text-align: center; max-width: 760px; margin: 0 auto 48px;\">Most brands start with one category and expand. Combine aging with adjacent categories to grow lifetime value per customer.</p>\n  </div>\n</div>\n<div style=\"background: white; padding: 0 20px 80px;\">\n  <div style=\"max-width: 1200px; margin: 0 auto;\">\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;\" class=\"pl-cat-grid\">\n<a href=\"/pl-demo-womens-health\" style=\"display: block; text-decoration: none;\">\n<div style=\"background: white;  box-shadow: 0 2px 8px rgba(1,38,56,.08); text-align: center;\">\n<img src=\"https://www.pettechlabs.com/hubfs/private-label/WOMENS-CATEGORY-PREXERA.png\" alt=\"Women's Health\" style=\"width: 100%; height: 180px; object-fit: cover; display: block;\">\n<div style=\"padding: 10px 12px;\">\n<p style=\"color: #012638; font-size: 15px; font-weight: 600; margin: 0;\">Women's Health</p>\n</div>\n</div></a><a href=\"/pl-demo-mens-health\" style=\"display: block; text-decoration: none;\">\n<div style=\"background: white;  box-shadow: 0 2px 8px rgba(1,38,56,.08); text-align: center;\">\n<img src=\"https://www.pettechlabs.com/hubfs/private-label/PREXERA-MENS.png\" alt=\"Men's Health\" style=\"width: 100%; height: 180px; object-fit: cover; display: block;\">\n<div style=\"padding: 10px 12px;\">\n<p style=\"color: #012638; font-size: 15px; font-weight: 600; margin: 0;\">Men's Health</p>\n</div>\n</div></a><a href=\"/pl-demo-probiotics\" style=\"display: block; text-decoration: none;\">\n<div style=\"background: white;  box-shadow: 0 2px 8px rgba(1,38,56,.08); text-align: center;\">\n<img src=\"https://www.pettechlabs.com/hubfs/private-label/prexera-probiotic_supplements.png\" alt=\"Probiotics\" style=\"width: 100%; height: 180px; object-fit: cover; display: block;\">\n<div style=\"padding: 10px 12px;\">\n<p style=\"color: #012638; font-size: 15px; font-weight: 600; margin: 0;\">Probiotics</p>\n</div>\n</div></a><a href=\"/pl-demo-sleep\" style=\"display: block; text-decoration: none;\">\n<div style=\"background: white;  box-shadow: 0 2px 8px rgba(1,38,56,.08); text-align: center;\">\n<img src=\"https://www.pettechlabs.com/hubfs/private-label/sleep-prexera.png\" alt=\"Sleep\" style=\"width: 100%; height: 180px; object-fit: cover; display: block;\">\n<div style=\"padding: 10px 12px;\">\n<p style=\"color: #012638; font-size: 15px; font-weight: 600; margin: 0;\">Sleep</p>\n</div>\n</div></a><a href=\"/pl-demo-fitness\" style=\"display: block; text-decoration: none;\">\n<div style=\"background: white;  box-shadow: 0 2px 8px rgba(1,38,56,.08); text-align: center;\">\n<img src=\"https://www.pettechlabs.com/hubfs/private-label/prexera-fitness_supplements.png\" alt=\"Fitness\" style=\"width: 100%; height: 180px; object-fit: cover; display: block;\">\n<div style=\"padding: 10px 12px;\">\n<p style=\"color: #012638; font-size: 15px; font-weight: 600; margin: 0;\">Fitness</p>\n</div>\n</div></a><a href=\"/pl-demo-weight-management\" style=\"display: block; text-decoration: none;\">\n<div style=\"background: white;  box-shadow: 0 2px 8px rgba(1,38,56,.08); text-align: center;\">\n<img src=\"https://www.pettechlabs.com/hubfs/private-label/prexera-weight-supplements.png\" alt=\"Weight Management\" style=\"width: 100%; height: 180px; object-fit: cover; display: block;\">\n<div style=\"padding: 10px 12px;\">\n<p style=\"color: #012638; font-size: 15px; font-weight: 600; margin: 0;\">Weight Management</p>\n</div>\n</div></a><a href=\"/pl-demo-cognitive\" style=\"display: block; text-decoration: none;\">\n<div style=\"background: white;  box-shadow: 0 2px 8px rgba(1,38,56,.08); text-align: center;\">\n<img src=\"https://www.pettechlabs.com/hubfs/private-label/cognitive-prexera.png\" alt=\"Cognitive\" style=\"width: 100%; height: 180px; object-fit: cover; display: block;\">\n<div style=\"padding: 10px 12px;\">\n<p style=\"color: #012638; font-size: 15px; font-weight: 600; margin: 0;\">Cognitive</p>\n</div>\n</div></a><a href=\"/pl-demo-pillar\" style=\"display: block; text-decoration: none;\">\n<div style=\"background: #012638;  box-shadow: 0 2px 8px rgba(1,38,56,.10); text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 180px;\">\n<div style=\"color: #6ba644; font-size: 56px; font-weight: bold; line-height: 1;\">+</div>\n<p style=\"color: white; font-size: 17px; font-weight: normal; margin: 0px;\">AND MORE</p>\n</div></a>\n</div>\n</div>\n</div>\n  </div>\n</div>"
