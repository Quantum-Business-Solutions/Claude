     "type": "rich_text"
    },
    {
     "body": {
      "html": "<div style=\"background: #f7f7f6; padding: 80px 20px;\">\n  <div style=\"max-width: 1200px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 16px;\">Categories where gummies shine</h2>\n    <p style=\"color: #555; font-size: 17px; text-align: center; max-width: 760px; margin: 0 auto 48px;\">Some health categories work better in gummies than others. Here are the ones where this format is the natural choice.</p>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px;\">\n      <a href=\"/private-label-womens-health\" style=\"display: block; text-decoration: none;\">\n      <div style=\"background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(1,38,56,.08);\">\n        <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/womenssupps.png\" alt=\"Women's Health\" style=\"width: 100%; height: 160px; object-fit: cover; display: block;\"/>\n        <div style=\"padding: 18px 20px; text-align: center;\">\n          <p style=\"color: #012638; font-size: 17px; font-weight: 700; margin: 0;\">Women's Health</p>\n        </div>\n      </div>\n    </a><a href=\"/private-label-sleep\" style=\"display: block; text-decoration: none;\">\n      <div style=\"background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(1,38,56,.08);\">\n        <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/sleepsupps.png\" alt=\"Sleep\" style=\"width: 100%; height: 160px; object-fit: cover; display: block;\"/>\n        <div style=\"padding: 18px 20px; text-align: center;\">\n          <p style=\"color: #012638; font-size: 17px; font-weight: 700; margin: 0;\">Sleep</p>\n        </div>\n      </div>\n    </a><a href=\"/private-label-probiotics\" style=\"display: block; text-decoration: none;\">\n      <div style=\"background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(1,38,56,.08);\">\n        <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/probioticsupps.png\" alt=\"Probiotics\" style=\"width: 100%; height: 160px; object-fit: cover; display: block;\"/>\n        <div style=\"padding: 18px 20px; text-align: center;\">\n          <p style=\"color: #012638; font-size: 17px; font-weight: 700; margin: 0;\">Probiotics</p>\n        </div>\n      </div>\n    </a><a href=\"/private-label-aging\" style=\"display: block; text-decoration: none;\">\n      <div style=\"background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(1,38,56,.08);\">\n        <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/agingsupps.png\" alt=\"Aging\" style=\"width: 100%; height: 160px; object-fit: cover; display: block;\"/>\n        <div style=\"padding: 18px 20px; text-align: center;\">\n          <p style=\"color: #012638; font-size: 17px; font-weight: 700; margin: 0;\">Aging</p>\n        </div>\n      </div>\n    </a><a href=\"/private-label-fitness\" style=\"display: block; text-decoration: none;\">\n      <div style=\"background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 16px rgba(1,38,56,.08);\">\n        <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/fitnesssupps.png\" alt=\"Fitness\" style=\"width: 100%; height: 160px; object-fit: cover; display: block;\"/>\n        <div style=\"padding: 18px 20px; text-align: center;\">\n          <p style=\"color: #012638; font-size: 17px; font-weight: 700; margin: 0;\">Fitness</p>\n        </div>\n      </div>\n    </a>\n    </div>\n  </div>\n</div>"
     },
     "id": 216207157046,
     "type": "rich_text"
    },
    {
     "body": {
      "html": "<div style=\"background: white; padding: 80px 20px;\">\n  <div style=\"max-width: 820px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 16px;\">Gummies questions we hear most often</h2>\n    <p style=\"color: #555; font-size: 17px; text-align: center; margin: 0 0 44px;\">Quick answers to the questions brand owners ask before they commit.</p>\n    <details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>What is the difference between gelatin and pectin gummies?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Gelatin gummies are made from animal-derived gelatin (most often bovine or porcine). Pectin gummies are made from fruit-derived pectin and are vegan, kosher, and halal compatible. Pectin gummies tend to have a slightly firmer texture and are now the standard for new product launches due to broader audience appeal.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Can you do sugar-free gummies?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Yes. Sugar-free gummies using allulose, monk fruit, stevia, or sugar alcohol combinations are available. Allulose-based formulations have the closest mouthfeel to traditional sugar without the glycemic impact. Sugar-free is now the default request for most new gummy launches.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Why are gummy minimums higher than other formats?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Gummy production requires depositing line setup, mold preparation, and 24-48 hour drying cycles. The economics of starting a run mean minimum order volumes are higher than for tablet or capsule runs. We are direct about these minimums during the discovery call so you can plan inventory accordingly.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Are gummies heat-stable for shipping?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Gummies can soften or melt in high-heat shipping conditions. We use packaging and shipping practices designed to minimize heat exposure (insulated packaging in summer months, climate-aware fulfillment timing). Some gummies are formulated for higher heat tolerance, which is scoped during formulation if it matters for your audience.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>How do you verify active dose in gummies given the cooking process?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Cooking-sensitive actives are added at controlled temperatures and verified through finished-product testing on every batch. We over-formulate certain heat-sensitive ingredients (within FDA-allowed tolerance) to ensure the label claim is met at end of shelf life, not just at production.</div>\n    </details>\n  </div>\n</div>"
     },
     "id": 216207157047,
     "type": "rich_text"
    },
    {
     "body": {
      "html": "<div style=\"background: #f7f7f6; padding: 80px 20px;\">\n  <div style=\"max-width: 1200px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 16px;\">Other supplement forms we offer</h2>\n    <p style=\"color: #555; font-size: 17px; text-align: center; max-width: 760px; margin: 0 auto 48px;\">Most brands launch with two or three formats to give customers options. Here is the full list of formats we manufacture.</p>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 36px 24px;\">\n      <div style=\"text-align: center;\">\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_AS_Capsules.jpg\" alt=\"Capsules\" style=\"width: 100%; max-width: 180px; height: auto; border-radius: 8px; margin: 0 0 14px;\"/>\n      <p style=\"color: #012638; font-size: 16px; font-weight: 600; margin: 0;\">Capsules</p>\n    </div><div style=\"text-align: center;\">\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_AS_Tablets.jpg\" alt=\"Tablets\" style=\"width: 100%; max-width: 180px; height: auto; border-radius: 8px; margin: 0 0 14px;\"/>\n      <p style=\"color: #012638; font-size: 16px; font-weight: 600; margin: 0;\">Tablets</p>\n    </div><div style=\"text-align: center;\">\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_AS_SoftGel.jpg\" alt=\"Soft Gels\" style=\"width: 100%; max-width: 180px; height: auto; border-radius: 8px; margin: 0 0 14px;\"/>\n      <p style=\"color: #012638; font-size: 16px; font-weight: 600; margin: 0;\">Soft Gels</p>\n    </div><div style=\"text-align: center;\">\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_AS_Powders.jpg\" alt=\"Powders\" style=\"width: 100%; max-width: 180px; height: auto; border-radius: 8px; margin: 0 0 14px;\"/>\n      <p style=\"color: #012638; font-size: 16px; font-weight: 600; margin: 0;\">Powders</p>\n    </div><div style=\"text-align: center;\">\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_AS_ChewableTablet.jpg\" alt=\"Chewables\" style=\"width: 100%; max-width: 180px; height: auto; border-radius: 8px; margin: 0 0 14px;\"/>\n      <p style=\"color: #012638; font-size: 16px; font-weight: 600; margin: 0;\">Chewables</p>\n    </div><div style=\"text-align: center;\">\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_AS_Liquid.jpg\" alt=\"Liquids\" style=\"width: 100%; max-width: 180px; height: auto; border-radius: 8px; margin: 0 0 14px;\"/>\n      <p style=\"color: #012638; font-size: 16px; font-weight: 600; margin: 0;\">Liquids</p>\n    </div><div style=\"text-align: center;\">\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_AS_Spray.jpg\" alt=\"Oral Sprays\" style=\"width: 100%; max-width: 180px; height: auto; border-radius: 8px; margin: 0 0 14px;\"/>\n      <p style=\"color: #012638; font-size: 16px; font-weight: 600; margin: 0;\">Oral Sprays</p>\n    </div>\n    </div>\n  </div>\n</div>"
     },
     "id": 216207157048,
     "type": "rich_text"
    },
