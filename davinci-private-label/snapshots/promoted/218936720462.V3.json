          "module_id": 218940115735,
          "section_headline": "",
          "stats": [
           {
            "description": "<p>Six standard capsule sizes from 00 (largest, ~1000mg fill) to size 4 (smallest, ~210mg fill). Choose based on your formulation and target audience.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "size_type": "auto",
             "src": "https://www.pettechlabs.com/hubfs/private-label/icons/pl-icon-7389db2445.svg"
            },
            "stat_label": "Size Options",
            "value": "00 - 4"
           },
           {
            "description": "<p>Hard-shell bovine gelatin (most common, lowest cost) or HPMC vegetarian capsules (plant-based, kosher, halal compatible). Pick what fits your brand positioning.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "size_type": "auto",
             "src": "https://www.pettechlabs.com/hubfs/private-label/icons/pl-icon-0e742f57f3.svg"
            },
            "stat_label": "Material Options",
            "value": "2"
           },
           {
            "description": "<p>Fill range depends on capsule size and ingredient density. Our formulators help right-size the capsule to dosing requirements and customer experience.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "size_type": "auto",
             "src": "https://www.pettechlabs.com/hubfs/private-label/icons/pl-icon-04cb8f7fc7.svg"
            },
            "stat_label": "Fill Capacity",
            "value": "210mg - 1000mg"
           },
           {
            "description": "<p>Low order minimums and no set-up fees. Exact MOQ varies by formulation complexity and is scoped during the discovery call.</p>",
            "icon": {
