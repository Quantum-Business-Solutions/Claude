          "module_id": 218940115735,
          "section_headline": "",
          "stats": [
           {
            "description": "<p>1oz dropper bottles for premium concentrated formulas, 4-8oz for standard daily-dose liquids, 16oz for higher-volume immune and wellness shots. Glass or food-grade plastic available.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "size_type": "auto",
             "src": "https://www.pettechlabs.com/hubfs/private-label/icons/pl-icon-7389db2445.svg"
            },
            "stat_label": "Bottle Sizes",
            "value": "1oz - 16oz"
           },
           {
            "description": "<p>Calibrated droppers (1ml, 2.5ml, 5ml) for precise dosing. Measured dosing cups for larger servings. Pumps available for ongoing-use products like sprays and oils.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "size_type": "auto",
             "src": "https://www.pettechlabs.com/hubfs/private-label/icons/pl-icon-04cb8f7fc7.svg"
            },
            "stat_label": "Dosing Options",
            "value": "Dropper or Cup"
           },
           {
            "description": "<p>Citrus, berry, and vanilla are our most common liquid flavor profiles. Unflavored available for liposomal and pure-active formulations. Sweeteners include stevia, monk fruit, and natural fruit concentrates.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "size_type": "auto",
             "src": "https://www.pettechlabs.com/hubfs/private-label/icons/pl-icon-e2f38469a7.svg"
            },
            "stat_label": "Flavor Systems",
            "value": "Natural Flavors"
           },
           {
            "description": "<p>Low order minimums and no set-up fees. Liquid manufacturing has slightly higher MOQ than tablets due to bottling and filling minimums. Exact MOQ scoped during discovery.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "size_type": "auto",
             "src": "https://www.pettechlabs.com/hubfs/private-label/icons/pl-icon-681f7474d8.svg"
            },
            "stat_label": "Minimums &amp; Set-Up",
            "value": "Low MOQ"
           }
          ],
