          "max_width": 1100,
          "min_column_width": 260,
          "module_id": 218940115759,
          "section_eyebrow": "HOW IT WORKS",
          "section_headline": "Get to market faster with a partner who handles the heavy lifting.",
          "section_subhead": "",
          "show_accent": true,
