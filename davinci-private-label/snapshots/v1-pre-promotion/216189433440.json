bs.com/private-label/how-to-market-private-label-supplements\" style=\"color:#6BA644; text-decoration:none; font-size:14px; line-height:1.45; font-weight:600;\">How to Market Private Label Supplements &rsaquo;</a></li><li style=\"margin:0 0 9px;\"><a href=\"https://blog.davincilabs.com/private-label/tips-for-selling-private-label-supplements-on-amazon\" style=\"color:#6BA644; text-decoration:none; font-size:14px; line-height:1.45; font-weight:600;\">Tips for Selling Private Label Supplements on Amazon &rsaquo;</a></li><li style=\"margin:0 0 9px;\"><a href=\"https://blog.davincilabs.com/private-label/how-do-i-start-a-private-label-supplement-business\" style=\"color:#6BA644; text-decoration:none; font-size:14px; line-height:1.45; font-weight:600;\">How to Start a Private Label Supplement Business &rsaquo;</a></li></ul>\n    </div><div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M12 21a9 9 0 0 0 0-18m0 18a9 9 0 0 1 0-18m0 18c2.07 0 3.75-4.03 3.75-9S14.07 3 12 3m0 18c-2.07 0-3.75-4.03-3.75-9S9.93 3 12 3M3.6 9h16.8M3.6 15h16.8\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Distribution</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Direct-to-consumer, retail, Amazon, healthcare professional channels. Trade-offs and what works for different brand types.</p><ul style=\"list-style:none; margin:16px 0 0; padding:0;\"><li style=\"margin:0 0 9px;\"><a href=\"https://www.davincilabs.com/private-labeling-dropship\" style=\"color:#6BA644; text-decoration:none; font-size:14px; line-height:1.45; font-weight:600;\">Dropship Private Label Supplements &rsaquo;</a></li><li style=\"margin:0 0 9px;\"><a href=\"https://blog.davincilabs.com/private-label/managing-private-label-shipping-and-inventory-a-step-by-step-guide\" style=\"color:#6BA644; text-decoration:none; font-size:14px; line-height:1.45; font-weight:600;\">Managing Private Label Shipping and Inventory &rsaquo;</a></li></ul>\n    </div><div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M15 19.13a9.38 9.38 0 0 1 6-2.18 9.38 9.38 0 0 1 6 2.18M15 19.13v-.41c0-.86-.16-1.69-.45-2.45M15 19.13v.13a1.62 1.62 0 0 1-1.6 1.62l-.55 0c-1.05-.05-2.1-.05-3.15 0l-.55 0a1.62 1.62 0 0 1-1.6-1.62v-.13m6.85-2.86a4.49 4.49 0 0 0-2.85-1.05c-1.07 0-2.07.38-2.85 1.05m5.7 0a4.49 4.49 0 0 1 1.4 2.45m-7.1-2.45a4.49 4.49 0 0 0-1.4 2.45m2.85-7.95a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Audience & Positioning</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Picking a niche, audience segmentation, and how to differentiate in crowded supplement categories.</p><ul style=\"list-style:none; margin:16px 0 0; padding:0;\"><li style=\"margin:0 0 9px;\"><a href=\"https://blog.davincilabs.com/private-label/best-private-label-supplements-for-gut-health\" style=\"color:#6BA644; text-decoration:none; font-size:14px; line-height:1.45; font-weight:600;\">Best Private Label Supplements for Gut Health &rsaquo;</a></li><li style=\"margin:0 0 9px;\"><a href=\"https://blog.davincilabs.com/private-label/tips-for-selling-private-label-supplements-for-immunity\" style=\"color:#6BA644; text-decoration:none; font-size:14px; line-height:1.45; font-weight:600;\">Tips for Selling Supplements for Immunity &rsaquo;</a></li><li style=\"margin:0 0 9px;\"><a href=\"https://blog.davincilabs.com/private-label/how-physicians-can-get-better-private-labeling-for-supplements\" style=\"color:#6BA644; text-decoration:none; font-size:14px; line-height:1.45; font-weight:600;\">How Physicians Can Get Better Private Labeling &rsaquo;</a></li><li style=\"margin:0 0 9px;\"><a href=\"https://blog.davincilabs.com/private-label/top-questions-consumers-have-about-private-label-supplements\" style=\"color:#6BA644; text-decoration:none; font-size:14px; line-height:1.45; font-weight:600;\">Top Questions Consumers Have About Private Label &rsaquo;</a></li></ul>\n    </div>\n    </div>\n  </div>\n</div>"},"child_css":{},"css":{},"id":216207762502,"order":5,"styles":{},"type":"rich_text"},{"body":{"html":"<div id=\"get-started\" style=\"background: #e6e5e3; padding: 80px 20px; text-align: center;\">\n  <div style=\"max-width: 720px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; line-height: 1.25; margin: 0 0 16px;\">Ready to launch your private label supplement line?</h2>\n    <p style=\"color: #333; font-size: 17px; line-height: 1.55; margin: 0 0 32px;\">Schedule a consultation. We will walk through your audience, the right formulations for them, branding options, and the timeline.</p>\n    <a href=\"https://www.davincilabs.com/private-label-get-started\" style=\"display: inline-block; background: #6BA644; color: white; padding: 16px 40px; text-decoration: none; font-size: 16px; font-weight: 700; border-radius: 4px; letter-spacing: .5px;\">Schedule a Consultation</a>\n  </div>\n</div>"},"child_css":{},"css":{},"id":216207762503,"order":6,"styles":{},"type":"rich_text"},{"body":{},"id":218950032294,"label":"PL - Global Guide Offer","module_id":218944099153,"order":7,"type":"module"},{"body":{"html":"<div style=\"background: #e6e5e3; padding: 80px 20px; text-align: center;\">\n<div style=\"max-width: 900px; margin: 0 auto;\">\n<p style=\"color: #6ba644; font-size: 13px; font-weight: bold; letter-spacing: 2px; margin: 0 0 12px;\">50+ YEARS OF PROVIDING TOP-QUALITY SUPPLEMENTS</p>\n<h2 style=\"color: #012638; font-size: 32px; font-weight: bold; line-height: 1.25; margin: 0 0 20px;\">Developed by us. Made for you.</h2>\n<p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">With over 50 years in the health supplement industry, we are one of the most trusted dietary supplement providers. Every private label supplement we produce is doctor-formulated using thoroughly researched ingredients, then scientifically reviewed for efficacy and quality before it ever enters production in our U.S. facilities.</p>\n<p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">Prexera is a division of FoodScience Corp, an FDA-registered food facility, GMP certified to SQF food safety standards, and certified to NSF GMP 455-2.</p>\n<p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">When you partner with us, our expert team is with you every step of the way. Help your customers find what they want from a source they trust. You.</p>\n</div>\n</div>"},"child_css":{},"css":{},"id":216207762505,"order":8,"styles":{},"type":"rich_text"},{"body":{"html":"<div style=\"background: #f7f7f6; padding: 80px 20px;\">\n  <div style=\"max-width: 820px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 16px;\">Frequently asked questions</h2>\n    <p style=\"color: #555; font-size: 17px; text-align: center; margin: 0 0 44px;\">None</p>\n    <details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>What's the most useful resource if I'm just exploring private label?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">The Definitive Guide to Private Label Supplements. It covers what private label is, what it costs, how to choose categories, FDA basics, and how to think about a launch plan. Most clients read it before their first consultation.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Do you charge for these guides?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">No. All our resources are free. We share them because educated clients make better decisions and better partners. If you find the guides useful, that's a good sign we'd be a fit to work together.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>How often do you publish new resources?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">We add new guides and case studies as the industry evolves. Major guides are refreshed annually. Subscribe to updates during your consultation to be notified when new resources publish.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Can I share these guides with my team or partners?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Yes. Feel free to share any of our resources internally or with partners. We ask you not to repost them publicly on your own site without attribution, but sharing within your business or with vendors is totally fine.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Do you publish industry data or market research?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">We share aggregated insights from our private label client base when patterns emerge that brand builders should know. We don't publish proprietary client data. Industry data on the broader supplement market is best sourced from NPD, SPINS, or the Council for Responsible Nutrition.</div>\n    </details>\n  </div>\n</div>"},"child_css":{},"css":{},"id":216207762506,"order":9,"styles":{},"type":"rich_text"},{"body":{},"id":218950032752,"label":"PL - Global FDA Disclaimer","module_id":218942529652,"order":10,"type":"module"}]}},"widgets":{}}