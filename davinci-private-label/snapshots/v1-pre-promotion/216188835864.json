     "body": {
      "html": "<div id=\"get-started\" style=\"background: #e6e5e3; padding: 80px 20px; text-align: center;\">\n  <div style=\"max-width: 720px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; line-height: 1.25; margin: 0 0 16px;\">Ready to launch your supplement line in chewables?</h2>\n    <p style=\"color: #333; font-size: 17px; line-height: 1.55; margin: 0 0 32px;\">Schedule a consultation and we will walk through formulation options, packaging, branding, and the timeline. Most brands launch within 3 to 4 weeks of approving labels, 8 to 12 weeks from first conversation.</p>\n    <a href=\"#get-started\" style=\"display: inline-block; background: #6BA644; color: white; padding: 16px 40px; text-decoration: none; font-size: 16px; font-weight: 700; border-radius: 4px; letter-spacing: .5px;\">Schedule a Consultation</a>\n  </div>\n</div>"
     },
