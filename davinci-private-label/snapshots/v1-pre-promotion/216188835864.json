     "body": {
      "html": "<div style=\"background: #f7f7f6; padding: 70px 20px 30px; text-align: center;\">\n  <div style=\"max-width: 900px; margin: 0 auto;\">\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 12px;\">ADVANTAGES</p>\n    <h2 style=\"color: #012638; font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0;\">What makes chewables a strong supplement format.</h2>\n    \n  </div>\n</div>"
     },
