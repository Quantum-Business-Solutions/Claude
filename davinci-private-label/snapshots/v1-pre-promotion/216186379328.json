{"archivedAt":"1970-01-01T00:00:00Z","archivedInDashboard":false,"attachedStylesheets":[],"authorName":"Shawn Peterson","categoryId":1,"contentTypeCategory":4,"createdAt":"2026-06-30T17:22:12.745Z","createdById":"26261533","currentState":"DRAFT","domain":"info.davincilabs.com","featuredImage":"","featuredImageAltText":"","htmlTitle":"Our Quality Standards | DaVinci Private Label","id":"216186379328","language":"en","layoutSections":{},"metaDescription":"FDA-registered, GMP certified to SQF and NSF GMP 455-2 standards. Multi-stage testing from raw material to finished bottle. Truth-in-labeling commitment.","name":"Private Label - Page - Quality Standards","pageRedirected":false,"publicAccessRules":[],"publicAccessRulesEnabled":false,"publishDate":"1970-01-01T00:00:00Z","published":false,"slug":"pl-demo-quality-standards","state":"DRAFT","subcategory":"site_page","templatePath":"Private Label/Templates/Page.html","translations":{},"updatedAt":"2026-08-07T19:41:53.052Z","updatedById":"26261533","url":"https://info.davincilabs.com/pl-demo-quality-standards","useFeaturedImage":false,"widgetContainers":{"main_content":{"widgets":[{"body":{"html":"<div style=\"background: linear-gradient(rgba(201,219,226,.85), rgba(201,219,226,.85)), url('https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_HeroBackground_2.jpg') center/cover; padding: 90px 20px; text-align: center;\">\n  <div style=\"max-width: 900px; margin: 0 auto;\">\n    <p style=\"color: #012638; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 14px;\">QUALITY STANDARDS</p>\n    <h1 style=\"color: #012638; font-size: 48px; font-weight: 700; line-height: 1.15; margin: 0 0 22px;\">Doctor-formulated, scientifically reviewed, manufactured to the highest standards.</h1>\n    <p style=\"color: #012638; font-size: 19px; line-height: 1.5; margin: 0 0 34px;\">Quality is not a feature of our manufacturing process. It is the entire process.</p>\n    <a href=\"#certifications\" style=\"display: inline-block; background: #6BA644; color: white; padding: 16px 38px; text-decoration: none; font-size: 16px; font-weight: 700; border-radius: 4px; letter-spacing: .5px;\">See Our Certifications</a>\n  </div>\n</div>"},"id":216207157145,"type":"rich_text"},{"body":{"html":"<div style=\"max-width: 850px; margin: 0 auto; padding: 80px 20px 50px;\">\n  <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; line-height: 1.25; margin: 0 0 26px;\">Quality your customers can verify, not just your sales team can claim.</h2>\n  <p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">Customers are more skeptical of supplement claims than ever, and they should be. The brands that earn trust are the ones whose quality is verifiable: certified facilities, third-party testing, transparent sourcing, and certificates of analysis available on request.</p><p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">Here is how we make sure every private label product we manufacture earns that trust on day one.</p>\n</div>"},"id":216207157146,"type":"rich_text"},{"body":{"html":"<div style=\"background: #012638; padding: 70px 20px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 40px;\">\n      <div style=\"text-align: center;\">\n      <p style=\"color: #6BA644; font-size: 48px; font-weight: 800; line-height: 1; margin: 0;\">50+</p>\n      <p style=\"color: white; font-size: 14px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 0;\">Years manufacturing</p>\n      <p style=\"color: white; opacity: .7; font-size: 13px; margin: 6px 0 0;\">Dietary supplements since 1972</p>\n    </div><div style=\"text-align: center;\">\n      <p style=\"color: #6BA644; font-size: 48px; font-weight: 800; line-height: 1; margin: 0;\">100%</p>\n      <p style=\"color: white; font-size: 14px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 0;\">U.S. facility</p>\n      <p style=\"color: white; opacity: .7; font-size: 13px; margin: 6px 0 0;\">Manufactured in Vermont</p>\n    </div><div style=\"text-align: center;\">\n      <p style=\"color: #6BA644; font-size: 48px; font-weight: 800; line-height: 1; margin: 0;\">FDA</p>\n      <p style=\"color: white; font-size: 14px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 0;\">Registered</p>\n      <p style=\"color: white; opacity: .7; font-size: 13px; margin: 6px 0 0;\">Food facility, fully inspected</p>\n    </div><div style=\"text-align: center;\">\n      <p style=\"color: #6BA644; font-size: 48px; font-weight: 800; line-height: 1; margin: 0;\">455-2</p>\n      <p style=\"color: white; font-size: 14px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 0;\">NSF GMP</p>\n      <p style=\"color: white; opacity: .7; font-size: 13px; margin: 6px 0 0;\">Certified to highest standard</p>\n    </div>\n    </div>\n  </div>\n</div>"},"id":216207157147,"type":"rich_text"},{"body":{"html":"<div style=\"background: white; padding: 70px 20px 30px; text-align: center;\">\n  <div style=\"max-width: 900px; margin: 0 auto;\">\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 12px;\">CERTIFICATIONS</p>\n    <h2 style=\"color: #012638; font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0;\">Independent certifications, not self-declared claims.</h2>\n    <p style=\"color: #333; font-size: 17px; line-height: 1.65; max-width: 760px; margin: 22px auto 0;\">Every certification we hold is awarded and audited by an independent third party. None of these are pay-to-list or self-declared.</p>\n  </div>\n</div>"},"id":216207157148,"type":"rich_text"},{"body":{"html":"<div style=\"background: white; padding: 60px 20px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; text-align: center; margin: 0 0 32px;\">THIRD-PARTY CERTIFIED</p>\n    <div style=\"display: flex; gap: 60px; justify-content: center; align-items: center; flex-wrap: wrap;\">\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_Logo_SQF.png\" alt=\"SQF Certified\" style=\"height: 80px; width: auto;\"/><img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/NSF.png\" alt=\"NSF GMP Certified\" style=\"height: 80px; width: auto;\"/>\n    </div>\n  </div>\n</div>"},"id":216207157149,"type":"rich_text"},{"body":{"html":"<div style=\"background: #f7f7f6; padding: 80px 20px;\">\n  <div style=\"max-width: 1200px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 16px;\">What our quality program actually means</h2>\n    <p style=\"color: #555; font-size: 17px; text-align: center; max-width: 760px; margin: 0 auto 48px;\">Certifications matter, but what matters more is what they require in practice. Here is what happens in our facility every day to maintain these standards.</p>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px;\">\n      <div style=\"background: white; padding: 32px 26px; border-radius: 8px; border-top: 4px solid #012638;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; background: #c9dbe2; border-radius: 12px; margin: 0 0 18px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M9.75 3.1v5.66m4.5-5.66v5.66m-4.5 0a3.38 3.38 0 0 1-1.5 6.43m6-6.43a3.38 3.38 0 0 0 1.5 6.43M4.5 19.5a4.5 4.5 0 0 0 4.5 4.5h6a4.5 4.5 0 0 0 4.5-4.5v-4.31a4.5 4.5 0 0 0-4.5-4.5h-6a4.5 4.5 0 0 0-4.5 4.5v4.31Z\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 28px; font-weight: 800; margin: 0; line-height: 1;\">100%</p>\n      <p style=\"color: #012638; font-size: 14px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin: 12px 0 14px;\">Batch Tested</p>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0;\">Every production batch undergoes identity, purity, and potency testing before release. Certificates of analysis available on request.</p>\n    </div><div style=\"background: white; padding: 32px 26px; border-radius: 8px; border-top: 4px solid #012638;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; background: #c9dbe2; border-radius: 12px; margin: 0 0 18px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M9 12.75 11.25 15 15 9.75M21 12c0 5.31-3.69 9.76-8.65 10.95a.84.84 0 0 1-.4.05.94.94 0 0 1-.41-.05A11.25 11.25 0 0 1 3 12V5.99c0-.46.31-.87.74-1.05A23.95 23.95 0 0 1 12 3a23.95 23.95 0 0 1 8.26 1.94c.43.18.74.59.74 1.05V12Z\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 28px; font-weight: 800; margin: 0; line-height: 1;\">GMP</p>\n      <p style=\"color: #012638; font-size: 14px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin: 12px 0 14px;\">Compliant</p>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0;\">Current Good Manufacturing Practices govern every step from raw material receipt through finished product shipping.</p>\n    </div><div style=\"background: white; padding: 32px 26px; border-radius: 8px; border-top: 4px solid #012638;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; background: #c9dbe2; border-radius: 12px; margin: 0 0 18px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M4.26 10.15a23.93 23.93 0 0 1 14.66-.36c.41.12.69.5.69.93v6.91a2.62 2.62 0 0 1-1.55 2.39 23.94 23.94 0 0 0-12.94 0 2.62 2.62 0 0 1-1.55-2.39v-6.92c0-.42.27-.8.69-.93Z\"/><path d=\"M4.26 10.15A23.93 23.93 0 0 1 12 9c1.05 0 2.08.1 3.07.31M4.26 10.15c-.85.46-1.7.98-2.51 1.55a25 25 0 0 0 10.25 5.32\"/><path d=\"M18.75 11.25v-2.4l3-1.62-7.5-4.23-7.5 4.23 3 1.62v2.4\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 28px; font-weight: 800; margin: 0; line-height: 1;\">PhD</p>\n      <p style=\"color: #012638; font-size: 14px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin: 12px 0 14px;\">Formulators</p>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0;\">Our in-house formulation team includes nutritionists and doctors. Every formula is scientifically reviewed before production.</p>\n    </div><div style=\"background: white; padding: 32px 26px; border-radius: 8px; border-top: 4px solid #012638;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; background: #c9dbe2; border-radius: 12px; margin: 0 0 18px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M12 21a9 9 0 0 0 0-18m0 18a9 9 0 0 1 0-18m0 18c2.07 0 3.75-4.03 3.75-9S14.07 3 12 3m0 18c-2.07 0-3.75-4.03-3.75-9S9.93 3 12 3M3.6 9h16.8M3.6 15h16.8\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 28px; font-weight: 800; margin: 0; line-height: 1;\">Sourced</p>\n      <p style=\"color: #012638; font-size: 14px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin: 12px 0 14px;\">Transparently</p>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0;\">We document every ingredient source. Where it comes from, what it tests at, and what its sustainability profile looks like.</p>\n    </div>\n    </div>\n  </div>\n</div>"},"id":216207157150,"type":"rich_text"},{"body":{"html":"<div style=\"background: white; padding: 70px 20px 30px; text-align: center;\">\n  <div style=\"max-width: 900px; margin: 0 auto;\">\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 12px;\">WHAT GMP MEANS</p>\n    <h2 style=\"color: #012638; font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0;\">Current Good Manufacturing Practices, in plain language.</h2>\n    \n  </div>\n</div>"},"id":216207157151,"type":"rich_text"},{"body":{"html":"<div style=\"background: white; padding: 10px 20px 70px;\">\n  <div style=\"max-width: 800px; margin: 0 auto;\">\n    <p style=\"color: #333; font-size: 17px; line-height: 1.7; margin: 0 0 18px;\"><strong style='color: #012638'>GMP is the FDA's framework for supplement manufacturing.</strong> It covers every aspect of production: facility cleanliness, equipment calibration, batch record documentation, raw material verification, testing protocols, packaging integrity, and shipping conditions.</p><p style=\"color: #333; font-size: 17px; line-height: 1.7; margin: 0 0 18px;\">Being GMP <em>compliant</em> means we follow these practices. Being GMP <em>certified</em> by NSF and SQF means an independent third party audits our facility to verify we actually do. The difference matters: certification requires unannounced inspections, documentation review, and continuous evidence of compliance.</p><p style=\"color: #333; font-size: 17px; line-height: 1.7; margin: 0 0 18px;\">For private label brands, this means you can confidently tell your customers that every product you sell was manufactured under the same standards as the brands they already trust.</p>\n  </div>\n</div>"},"id":216207157152,"type":"rich_text"},{"body":{"html":"<div style=\"background: #f7f7f6; padding: 90px 20px;\">\n  <div style=\"max-width: 820px; margin: 0 auto; text-align: center;\">\n    <div style=\"color: #6BA644; font-size: 72px; line-height: .8; font-family: Georgia, serif; margin: 0 0 -10px;\">&ldquo;</div>\n    <p style=\"color: #012638; font-size: 24px; line-height: 1.45; font-weight: 500; margin: 0 0 32px; font-style: italic;\">Our customers ask hard questions about where their supplements come from. Having DaVinci's certifications and certificates of analysis to point to has turned skeptical buyers into repeat customers.</p>\n    <p style=\"color: #012638; font-size: 16px; font-weight: 700; margin: 0;\">Private label brand partner</p>\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; margin: 4px 0 0;\">WELLNESS BRAND, 5-FIGURE MONTHLY VOLUME</p>\n  </div>\n</div>"},"id":216207157153,"type":"rich_text"},{"body":{"html":"<div style=\"background: white; padding: 80px 20px;\">\n  <div style=\"max-width: 820px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 16px;\">Quality questions we get most often</h2>\n    <p style=\"color: #555; font-size: 17px; text-align: center; margin: 0 0 44px;\">Direct answers to the questions buyers and brand partners ask before they commit.</p>\n    <details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Are your certifications independently audited or self-declared?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Independently audited. SQF certification is awarded by SQF International and renewed through annual third-party audits. NSF GMP 455-2 certification requires unannounced facility inspections and full documentation review by NSF auditors. None of our certifications are pay-to-list or self-declared.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Can I get certificates of analysis (COA) for my products?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Yes. Every production batch generates a certificate of analysis covering identity, purity, and potency testing. COAs are available on request for any product you private label with us, and can be provided to your customers on request as well.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Where are your supplements manufactured?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">All DaVinci private label supplements are manufactured in our Vermont facility. We do not contract production out to other manufacturers. This means full traceability and direct quality control on every batch.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>What is the difference between FDA-registered and FDA-approved?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">FDA does not 'approve' dietary supplements before they go to market. FDA-registered means the facility is registered with the FDA as a food facility and subject to FDA inspection. Our facility is FDA-registered and has been inspected. Combined with our GMP certifications, this gives a clear picture of regulatory compliance.</div>\n    </details><details style=\"background: white; border-radius: 6px; padding: 0; margin: 0 0 14px; border: 1px solid #e6e5e3; box-shadow: 0 1px 4px rgba(1,38,56,.04);\">\n      <summary style=\"cursor: pointer; padding: 22px 28px; font-size: 17px; font-weight: 700; color: #012638; list-style: none; display: flex; justify-content: space-between; align-items: center;\">\n        <span>Can you support custom testing requirements for my brand?</span>\n        <span style=\"color: #6BA644; font-size: 24px; font-weight: 700; flex-shrink: 0; margin-left: 16px;\">+</span>\n      </summary>\n      <div style=\"padding: 0 28px 24px; color: #444; font-size: 15px; line-height: 1.65;\">Yes. Beyond our standard testing protocols, we can run additional testing for specific ingredients, contaminants, or claims your brand wants to verify (heavy metals, allergens, microbials, specific actives). Custom testing requirements are scoped during the formulation phase.</div>\n    </details>\n  </div>\n</div>"},"id":216207157154,"type":"rich_text"},{"body":{"html":"<div id=\"get-started\" style=\"background: #e6e5e3; padding: 80px 20px; text-align: center;\">\n  <div style=\"max-width: 720px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; line-height: 1.25; margin: 0 0 16px;\">Ready to private label with a quality-first manufacturer?</h2>\n    <p style=\"color: #333; font-size: 17px; line-height: 1.55; margin: 0 0 32px;\">Schedule a consultation and we will walk through our quality program, your specific compliance needs, and how we make sure your brand earns customer trust on day one.</p>\n    <a href=\"#get-started\" style=\"display: inline-block; background: #6BA644; color: white; padding: 16px 40px; text-decoration: none; font-size: 16px; font-weight: 700; border-radius: 4px; letter-spacing: .5px;\">Schedule a Consultation</a>\n  </div>\n</div>"},"id":216207157155,"type":"rich_text"},{"body":{},"id":218949791145,"label":"PL - Global Guide Offer","module_id":218944099153,"order":11,"type":"module"},{"body":{"html":"<div style=\"background: #e6e5e3; padding: 90px 20px;\">\n  <div style=\"max-width: 900px; margin: 0 auto; text-align: center;\">\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 14px;\">50+ YEARS OF SUPPLEMENT MANUFACTURING</p>\n    <h2 style=\"color: #012638; font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0 0 24px;\">Developed by us. Made for you.</h2>\n    <p style=\"color: #333; font-size: 17px; line-height: 1.65; margin: 0 0 18px;\">With over 50 years in the health supplement industry, we are one of the most trusted dietary supplement manufacturers. Every private label supplement we produce is doctor-formulated using thoroughly researched ingredients, then scientifically reviewed for efficacy and quality before it ever enters production in our U.S. facilities.</p>\n    <p style=\"color: #333; font-size: 17px; line-height: 1.65; margin: 0 0 18px;\">FoodScience is an FDA-registered food facility, GMP certified to SQF food safety standards, and certified to NSF GMP 455-2.</p>\n    <p style=\"color: #333; font-size: 17px; line-height: 1.65; margin: 0 0 40px;\">When you partner with us, our expert team is with you every step of the way. Help your customers find what they want from a source they trust. You.</p>\n    <div style=\"display: flex; gap: 50px; justify-content: center; align-items: center; flex-wrap: wrap;\">\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_Logo_SQF.png\" alt=\"SQF Certified\" style=\"height: 80px; width: auto;\"/>\n      <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/NSF.png\" alt=\"NSF GMP Certified\" style=\"height: 80px; width: auto;\"/>\n    </div>\n  </div>\n</div>"},"id":216207157157,"type":"rich_text"},{"body":{},"id":218950233452,"label":"PL - Global FDA Disclaimer","module_id":218942529652,"order":13,"type":"module"}]}},"widgets":{}}