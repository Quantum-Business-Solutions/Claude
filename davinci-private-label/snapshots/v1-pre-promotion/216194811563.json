 "headHtml": "\n<!-- DVL-PL-FORM:START -->\n<style>\n  /* Center the form container on the page */\n  .hs_cos_wrapper_type_form,\n  .hs-form-private,\n  .hbspt-form {\n    max-width: 560px !important;\n    width: 100% !important;\n    margin-left: auto !important;\n    margin-right: auto !important;\n    display: block !important;\n  }\n\n  /* Fields stay left-aligned inside the container */\n  .hs-form label { color: #012638; font-size: 13px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 6px; display: block; text-align: left; }\n  .hs-form fieldset { max-width: 100% !important; }\n  .hs-form input[type=\"text\"],\n  .hs-form input[type=\"email\"],\n  .hs-form input[type=\"tel\"],\n  .hs-form textarea,\n  .hs-form select {\n    width: 100% !important; background: white !important;\n    border: 1px solid #c0cdd6 !important; border-radius: 4px !important;\n    padding: 12px 14px !important; font-size: 15px !important;\n    color: #012638 !important; margin-bottom: 20px !important;\n    box-sizing: border-box !important; text-align: left !important;\n  }\n  .hs-form input:focus, .hs-form textarea:focus {\n    outline: none !important; border-color: #6BA644 !important;\n    box-shadow: 0 0 0 3px rgba(107,166,68,.15) !important;\n  }\n  .hs-form textarea { min-height: 100px !important; }\n\n  /* Button full width inside centered container */\n  .hs-form input[type=\"submit\"], .hs-form .hs-button {\n    background: #6BA644 !important; color: white !important;\n    border: none !important; border-radius: 4px !important;\n    padding: 16px 40px !important; font-size: 16px !important;\n    font-weight: bold !important; letter-spacing: .5px !important;\n    cursor: pointer !important; display: block !important;\n    width: 100% !important; margin-top: 8px !important;\n  }\n  .hs-form input[type=\"submit\"]:hover, .hs-form .hs-button:hover { background: #5a9038 !important; }\n  .hs-form .hs-error-msgs { list-style: none; padding: 0; margin