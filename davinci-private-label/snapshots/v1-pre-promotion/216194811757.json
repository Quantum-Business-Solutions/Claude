     "body": {
      "html": "<div style=\"background: #f7f7f6; padding: 20px 20px 70px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px;\">\n      <div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M12 6.04A8.97 8.97 0 0 0 6 3.75c-1.05 0-2.06.18-3 .51v14.25A8.99 8.99 0 0 1 6 18c2.3 0 4.4.87 6 2.29m0-14.25a8.97 8.97 0 0 1 6-2.29c1.05 0 2.06.18 3 .51v14.25A8.99 8.99 0 0 0 18 18a8.97 8.97 0 0 0-6 2.29m0-14.25v14.25\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">The Definitive Guide</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">50+ pages on how private label supplements actually work. Free download.</p>\n    </div><div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M4.26 10.15a23.93 23.93 0 0 1 14.66-.36c.41.12.69.5.69.93v6.91a2.62 2.62 0 0 1-1.55 2.39 23.94 23.94 0 0 0-12.94 0 2.62 2.62 0 0 1-1.55-2.39v-6.92c0-.42.27-.8.69-.93Z\"/><path d=\"M4.26 10.15A23.93 23.93 0 0 1 12 9c1.05 0 2.08.1 3.07.31M4.26 10.15c-.85.46-1.7.98-2.51 1.55a25 25 0 0 0 10.25 5.32\"/><path d=\"M18.75 11.25v-2.4l3-1.62-7.5-4.23-7.5 4.23 3 1.62v2.4\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Onboarding Guide</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Week-by-week breakdown of your first 90 days as a client.</p>\n    </div><div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M12 21a9 9 0 0 0 0-18m0 18a9 9 0 0 1 0-18m0 18c2.07 0 3.75-4.03 3.75-9S14.07 3 12 3m0 18c-2.07 0-3.75-4.03-3.75-9S9.93 3 12 3M3.6 9h16.8M3.6 15h16.8\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Resource Library</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">More guides, articles, and tactical content.</p>\n    </div>\n    </div>\n  </div>\n</div>"
