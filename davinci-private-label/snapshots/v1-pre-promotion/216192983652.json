     "body": {
      "html": "<div style=\"background: linear-gradient(rgba(201,219,226,.85), rgba(201,219,226,.85)), url('https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_HeroBackground_2.jpg') center/cover; padding: 90px 20px; text-align: center;\">\n  <div style=\"max-width: 900px; margin: 0 auto;\">\n    <p style=\"color: #012638; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 14px;\">PRIVATE LABEL SUPPLEMENTS</p>\n    <h1 style=\"color: #012638; font-size: 48px; font-weight: 700; line-height: 1.15; margin: 0 0 22px;\">Made in the USA. FDA-registered, GMP-certified.</h1>\n    <p style=\"color: #012638; font-size: 19px; line-height: 1.5; margin: 0 0 34px;\">50 years of supplement manufacturing in Vermont. Doctor-formulated products, low minimums, fast turnaround. Your brand, our manufacturing infrastructure.</p>\n    <a href=\"#get-started\" style=\"display: inline-block; background: #6BA644; color: white; padding: 16px 38px; text-decoration: none; font-size: 16px; font-weight: 700; border-radius: 4px; letter-spacing: .5px;\">Schedule a Consultation</a>\n  </div>\n</div>"
