     "type": "rich_text"
    },
    {
     "body": {
      "html": "<div style=\"background: #f7f7f6; padding: 20px 20px 70px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px;\">\n      <div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M9 12.75 11.25 15 15 9.75M21 12c0 5.31-3.69 9.76-8.65 10.95a.84.84 0 0 1-.4.05.94.94 0 0 1-.41-.05A11.25 11.25 0 0 1 3 12V5.99c0-.46.31-.87.74-1.05A23.95 23.95 0 0 1 12 3a23.95 23.95 0 0 1 8.26 1.94c.43.18.74.59.74 1.05V12Z\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">U.S. manufacturing, FDA-registered</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">FDA-registered, GMP certified to SQF and NSF 455-2 standards. Manufactured in Vermont, U.S.A.</p>\n    </div><div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M12 6v12m-3-2.82.88.66c1.17.88 3.07.88 4.24 0 1.17-.88 1.17-2.3 0-3.18-.58-.44-1.35-.66-2.12-.66-.73 0-1.46-.22-2.01-.66-1.1-.88-1.1-2.3 0-3.18.95-.78 2.5-.87 3.62-.27M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Low minimums, no set-up fees</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Launch your brand without massive upfront inventory commitment. Per-unit pricing improves with volume.</p>\n    </div><div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M3.75 13.5 13.5 3l-2.25 7.5h6L9 21l2.25-7.5h-7.5Z\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Fast turnaround</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">8 to 12 weeks from first conversation to product shipping. 3 to 4 weeks production once labels are approved.</p>\n    </div>\n    </div>\n  </div>\n</div>"
     },
