    {
     "body": {
      "html": "<div style=\"background: #c9dbe2; padding: 80px 20px; text-align: center;\">\n<div style=\"max-width: 720px; margin: 0 auto;\">\n<p style=\"color: #012638; font-size: 13px; font-weight: bold; letter-spacing: 2px; margin: 0 0 14px;\">READY TO START</p>\n<h2 style=\"color: #012638; font-size: 32px; font-weight: bold; line-height: 1.25; margin: 0 0 16px;\">Schedule a consultation.</h2>\n<p style=\"color: #333; font-size: 18px; line-height: 1.55; margin: 0 0 32px;\">A 30-minute working session with a private label specialist. We will walk through your guide, your audience, and exactly what it takes to get your product to market.</p>\n<a href=\"/pl-demo-book-consultation\" style=\"display: inline-block; background: #6BA644; color: white; padding: 16px 40px; text-decoration: none; font-size: 16px; font-weight: bold; border-radius: 4px; letter-spacing: .5px;\">Schedule a Consultation</a></div>\n</div>"
     },
