CTA Band","name":"module_12","params":{"background_screen":{"color":"#012638","opacity":0},"buttons":[{"link":{"no_follow":false,"open_in_new_tab":false,"url":{"href":"#get-started","type":"EXTERNAL"}},"style":"primary","text":"Schedule a Consultation"}],"content":"<p>Schedule a consultation and we will walk through formulation options, packaging, branding, and the timeline. Most brands launch within 3 to 4 weeks of approving labels, 8 to 12 weeks from first conversation.</p>","eyebrow":"","headline":"Ready to launch your supplement line in tablets?","max_width":720,"module_id":218940115731,"section_id":"get-started","style":{"background_color":{"color":"#e6e5e3","opacity":100},"padding":{"padding_bottom":80,"padding_top":80}},"text_color":"dark"},"rowMetaData":[],"rows":[],"type":"module","w":0,"x":0}}],"type":"cell","w":0,"x":0}},{"0":{"cells":[],"cssClass":"","cssId":"","cssStyle":"","name":"column_13","params":{"css_class":"dnd-column"},"rowMetaData":[],"rows":[{"0":{"cells":[],"cssClass":"","cssId":"","cssStyle":"","label":"PL - Global Guide Offer","name":"module_13","params":{"module_id":218944099153},"rowMetaData":[],"rows":[],"type":"module","w":0,"x":0}}],"type":"cell","w":0,"x":0}},{"0":{"cells":[],"cssClass":"","cssId":"","cssStyle":"","name":"column_14","params":{"css_class":"dnd-column"},"rowMetaData":[],"rows":[{"0":{"cells":[],"cssClass":"","cssId":"","cssStyle":"","label":"PL - Section Header","name":"module_14","params":{"align":"center","eyebrow":"50+ YEARS OF SUPPLEMENT MANUFACTURING","headline":"Developed by us. Made for you.","module_id":218940115771,"section_id":"","style":{"background_color":{"color":"#e6e5e3","opacity":100},"padding":{"padding_bottom":0,"padding_top":90}},"subhead":"","text_color":"dark"},"rowMetaData":[],"rows":[],"type":"module","w":0,"x":0}}],"type":"cell","w":0,"x":0}},{"0":{"cells":[],"cssClass":"","cssId":"","cssStyle":"","name":"column_15","params":{"css_class":"dnd-column"},"rowMetaData":[],"rows":[{"0":{"cells":[],"cssClass":"","cssId":"","cssStyle":"","label":"PL - Rich Text","name":"module_15","params":{"align":"center","body_size":17,"content":"<p>With over 50 years in the health supplement industry, we are one of the most trusted dietary supplement manufacturers. Every private label supplement we produce is doctor-formulated using thoroughly researched ingredients, then scientifically reviewed for efficacy and quality before it ever enters production in our U.S. facilities.</p><p>FoodScience is an FDA-registered food facility, GMP certified to SQF food safety standards, and certified to NSF GMP 455-2.</p><p>When you partner with us, our expert team is with you every step of the way. Help your customers find what they want from a source they trust. You.</p><p style=\"display:flex;gap:50px;justify-content:center;align-items:center;flex-wrap:wrap;margin:40px 0 0;\"><img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/DV_PL_Logo_SQF.png\" alt=\"SQF Certified\" width=\"177\" height=\"80\" style=\"height:80px;width:auto;max-width:100%;\"><img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/NSF.png\" alt=\"NSF GMP Certified\" width=\"55\" height=\"80\" style=\"height:80px;width:auto;max-width:100%;\"></p>","max_width":900,"module_id":218940115784,"section_id":"","size":"normal","style":{"background_color":{"color":"#e6e5e3","opacity":100},"padding":{"padding_bottom":90,"padding_top":24}},"text_color":"dark","top_border":false},"rowMetaData":[],"rows":[],"type":"module","w":0,"x":0}}],"type":"cell","w":0,"x":0}},{"0":{"cells":[],"cssClass":"","cssId":"","cssStyle":"","name":"column_16","params":{"css_class":"dnd-column"},"rowMetaData":[],"rows":[{"0":{"cells":[],"cssClass":"","cssId":"","cssStyle":"","label":"PL - Global FDA Disclaimer","name":"module_16","params":{"module_id":218942529652},"rowMetaData":[],"rows":[],"type":"module","w":0,"x":0}}],"type":"cell","w":0,"x":0}}],"type":"cell","w":0,"x":0}},"metaDescription":"Private label tablet supplements. Standard tablets, scored tablets, chewables, and bilayer options. Cost-effective format with proven shelf stability.","name":"Private Label - Page - Tablets — V3 (New Modules)","pageRedirected":false,"publicAccessRules":[],"publicAccessRulesEnabled":false,"publishDate":"1970-01-01T00:00:00Z","published":false,"slug":"pl-demo-tablets-v3","state":"DRAFT","subcategory":"site_page","templatePath":"Private Label/Templates/Page - DND.html","translations":{},"updatedAt":"2026-08-07T20:59:32.192Z","updatedById":"26261533","url":"https://info.davincilabs.com/pl-demo-tablets-v3","useFeaturedImage":false,"widgetContainers":{"main_content":{"deleted_at":1786126404643,"widgets":[]}},"widgets":{}}