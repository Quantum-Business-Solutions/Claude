      "html": "<div style=\"background: #012638; padding: 70px 20px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 40px;\">\n      <div style=\"text-align: center;\">\n      <p style=\"color: #6BA644; font-size: 48px; font-weight: 800; line-height: 1; margin: 0;\">50+</p>\n      <p style=\"color: white; font-size: 14px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 0;\">years experience</p>\n      \n    </div><div style=\"text-align: center;\">\n      <p style=\"color: #6BA644; font-size: 48px; font-weight: 800; line-height: 1; margin: 0;\">250+</p>\n      <p style=\"color: white; font-size: 14px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 0;\">stock products</p>\n      \n    </div><div style=\"text-align: center;\">\n      <p style=\"color: #6BA644; font-size: 48px; font-weight: 800; line-height: 1; margin: 0;\">3-4 wk</p>\n      <p style=\"color: white; font-size: 14px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 0;\">to ship</p>\n      \n    </div><div style=\"text-align: center;\">\n      <p style=\"color: #6BA644; font-size: 48px; font-weight: 800; line-height: 1; margin: 0;\">100%</p>\n      <p style=\"color: white; font-size: 14px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 14px 0 0;\">USA-manufactured</p>\n      \n    </div>\n    </div>\n  </div>\n</div>"
