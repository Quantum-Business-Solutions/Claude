    {
     "body": {
      "html": "<div style=\"background-color: #f7f7f6; padding: 80px 24px;\">\n  <div style=\"max-width: 720px; margin: 0 auto;\">\n    \n        <div style=\"text-align: center; margin-bottom: 32px;\">\n          <h2 style=\"color: #012638; font-size: 36px; line-height: 1.2; margin: 0 0 16px 0; font-weight: 700;\">Schedule a consultation</h2></div>\n    <div style=\"background: #FFFFFF; padding: 40px; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);\">\n      <div id=\"hsform_e0762402c1e2\"></div>\n      <script charset=\"utf-8\" type=\"text/javascript\" src=\"//js.hsforms.net/forms/embed/v2.js\"></script>\n      <script>\n        if (window.hbspt) {\n          hbspt.forms.create({\n            portalId: \"4087538\",\n            formId: \"e0762402-c1e2-4a5a-8878-6441568fee67\",\n            target: \"#hsform_e0762402c1e2\"\n          });\n        }\n      </script>\n    </div>\n  </div>\n</div>"
