{"archivedAt":"1970-01-01T00:00:00Z","archivedInDashboard":false,"attachedStylesheets":[],"authorName":"Shawn Peterson","categoryId":1,"contentTypeCategory":4,"createdAt":"2026-06-30T17:55:18.532Z","createdById":"26261533","currentState":"DRAFT","domain":"info.davincilabs.com","featuredImage":"","featuredImageAltText":"","htmlTitle":"Private Label Herbal Supplements | [BRAND_TBD] Private Label","id":"216189432990","language":"en","layoutSections":{},"linkRelCanonicalUrl":"","metaDescription":"Premium herbal supplements for private label. Curcumin, adaptogens, botanical blends. Doctor-formulated, scientifically backed, ready to brand.","name":"Private Label - Page - Herbal Supplements","pageRedirected":false,"publicAccessRules":[],"publicAccessRulesEnabled":false,"publishDate":"1970-01-01T00:00:00Z","published":false,"slug":"en/pl-demo-herbal","state":"DRAFT","subcategory":"site_page","templatePath":"Private Label/Templates/Page.html","translations":{},"updatedAt":"2026-08-07T19:41:57.431Z","updatedById":"26261533","url":"https://info.davincilabs.com/en/pl-demo-herbal","useFeaturedImage":false,"widgetContainers":{"main_content":{"widgets":[{"body":{"html":"<div style=\"background: linear-gradient(rgba(201,219,226,.85), rgba(201,219,226,.85)), url('https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/private-label/herbalsupps.png') center/cover; padding: 90px 20px; text-align: center;\">\n  <div style=\"max-width: 900px; margin: 0 auto;\">\n    <p style=\"color: #012638; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 14px;\">PRIVATE LABEL HERBAL SUPPLEMENTS</p>\n    <h1 style=\"color: #012638; font-size: 48px; font-weight: 700; line-height: 1.15; margin: 0 0 22px;\">A concentrated source of active plant compounds for targeted wellness support.</h1>\n    <p style=\"color: #012638; font-size: 19px; line-height: 1.5; margin: 0 0 34px;\">Herbal supplements have a long history of use in natural practices and health support. Plants and herbs are rich in natural compounds that support body functions, enhance immunity, and promote overall health and well-being.</p>\n    <a href=\"#get-started\" style=\"display: inline-block; background: #6BA644; color: white; padding: 16px 38px; text-decoration: none; font-size: 16px; font-weight: 700; border-radius: 4px; letter-spacing: .5px;\">Talk to Our Team</a>\n  </div>\n</div>"},"child_css":{},"css":{},"id":216201609495,"order":0,"styles":{},"type":"rich_text"},{"body":{"html":"<div style=\"max-width: 850px; margin: 0 auto; padding: 80px 20px 50px;\">\n  <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; line-height: 1.25; margin: 0 0 26px;\">Build a herbal supplement line with proven formulations.</h2>\n  <p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">Choosing the best private-label herbal supplements for your brand comes down to a few factors: specific ingredient quality, the supporting ingredients required for optimal absorption, and the formulation itself. Customers expect to see results, so the products you sell need to perform on every front.</p><p style=\"color: #333; font-size: 18px; line-height: 1.65; margin: 0 0 18px;\">With direct access to over 250 doctor-formulated supplements, low minimums, and no set-up fees, you can build out a complete product line that fits your audience. Choose from our catalog of ready-to-launch formulations, customize the branding, and we handle manufacturing and fulfillment.</p>\n</div>"},"child_css":{},"css":{},"id":216201609496,"order":1,"styles":{},"type":"rich_text"},{"body":{"html":"<div style=\"background: #c9dbe2; padding: 70px 20px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; text-align: center; margin: 0 0 14px;\">HOW IT WORKS</p>\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 50px; line-height: 1.2;\">Get to market faster with a partner who handles the heavy lifting.</h2>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 40px;\">\n      <div style=\"text-align: left;\">\n      <p style=\"color: #6BA644; font-size: 56px; font-weight: 800; line-height: 1; margin: 0 0 14px;\">01</p>\n      <p style=\"color: #012638; font-size: 15px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 14px;\">BUILD YOUR PRODUCT LINE</p>\n      <p style=\"color: #012638; font-size: 15px; line-height: 1.6; margin: 0; opacity: .85;\">Direct access to over 250 doctor-formulated supplements with low minimums and no set-up fees. Choose what fits your audience and your timeline.</p>\n    </div><div style=\"text-align: left;\">\n      <p style=\"color: #6BA644; font-size: 56px; font-weight: 800; line-height: 1; margin: 0 0 14px;\">02</p>\n      <p style=\"color: #012638; font-size: 15px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 14px;\">DESIGN YOUR BRAND</p>\n      <p style=\"color: #012638; font-size: 15px; line-height: 1.6; margin: 0; opacity: .85;\">Use your existing logo, customize a new label, or pick from our professional templates. Our in-house design team brings your vision to life.</p>\n    </div><div style=\"text-align: left;\">\n      <p style=\"color: #6BA644; font-size: 56px; font-weight: 800; line-height: 1; margin: 0 0 14px;\">03</p>\n      <p style=\"color: #012638; font-size: 15px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 14px;\">START SELLING FAST</p>\n      <p style=\"color: #012638; font-size: 15px; line-height: 1.6; margin: 0; opacity: .85;\">Launch in as little as 3 to 4 weeks after approving your labels. Every product passes rigorous quality assurance before it ships.</p>\n    </div>\n    </div>\n  </div>\n</div>"},"child_css":{},"css":{},"id":216201609497,"order":2,"styles":{},"type":"rich_text"},{"body":{"html":"<div style=\"background: #f7f7f6; padding: 70px 20px 30px; text-align: center;\">\n  <div style=\"max-width: 900px; margin: 0 auto;\">\n    <p style=\"color: #6BA644; font-size: 13px; font-weight: 700; letter-spacing: 2px; margin: 0 0 12px;\">WHY HERBAL</p>\n    <h2 style=\"color: #012638; font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0;\">Why herbal supplements are a strong category to build a brand around.</h2>\n    \n  </div>\n</div>"},"child_css":{},"css":{},"id":216201609498,"order":3,"styles":{},"type":"rich_text"},{"body":{"html":"<div style=\"background: #f7f7f6; padding: 20px 20px 70px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px;\">\n      <div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M8.59 12.41a6 6 0 0 1 8.49-8.49l-1.06 1.06m-4.94 11.42L8.59 12.41m6.36 6.36-3.32-3.32m-1.4-1.4a6 6 0 0 0-3.74 1.43A6 6 0 0 0 4 21l1.5-1.5m11.13-11.13L21 4\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Targeted wellness, broad appeal</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Customers reach for herbal supplements to support immunity, sleep, stress management, digestion, and energy. One category that touches almost every wellness goal customers care about.</p>\n    </div><div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M9.75 3.1v5.66m4.5-5.66v5.66m-4.5 0a3.38 3.38 0 0 1-1.5 6.43m6-6.43a3.38 3.38 0 0 0 1.5 6.43M4.5 19.5a4.5 4.5 0 0 0 4.5 4.5h6a4.5 4.5 0 0 0 4.5-4.5v-4.31a4.5 4.5 0 0 0-4.5-4.5h-6a4.5 4.5 0 0 0-4.5 4.5v4.31Z\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Bioavailability drives results</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Some herbs need supporting ingredients to work. Curcumin combined with piperine. Active extracts paired with enzymes and minerals. Proprietary blends do this for you so customers actually feel the result.</p>\n    </div><div style=\"background: white; padding: 34px 30px; border-radius: 6px; border-top: 4px solid #6BA644; box-shadow: 0 2px 12px rgba(1,38,56,.06);\">\n      <div style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;background:#c9dbe2;border-radius:12px;margin:0 0 18px;\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:28px;height:28px;\"><path d=\"M9 12.75 11.25 15 15 9.75m-3-7.04L9.34 4.7l-3.94.34a1.69 1.69 0 0 0-1.36 1.36L3.7 10.34 2.7 12l1.04 2.66.34 3.94c.13.7.65 1.23 1.36 1.36l3.94.34L9.66 21.3 12 22.3l2.66-1.04 3.94-.34a1.69 1.69 0 0 0 1.36-1.36l.34-3.94 1.04-2.66-1.04-2.66-.34-3.94a1.69 1.69 0 0 0-1.36-1.36l-3.94-.34L12 2.7Z\"/></svg></div>\n      <h3 style=\"color: #012638; font-size: 19px; font-weight: 700; margin: 0 0 12px;\">Quality matters more than quantity</h3>\n      <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Your product line should contain only the purest, clinically relevant botanicals at restorative dosages. No extra fluff, no diluted formulas. Quality is the difference between a herbal brand customers trust and one they discard.</p>\n    </div>\n    </div>\n  </div>\n</div>"},"child_css":{},"css":{},"id":216201609499,"order":4,"styles":{},"type":"rich_text"},{"body":{"html":"<div style=\"background: white; padding: 80px 20px;\">\n  <div style=\"max-width: 1200px; margin: 0 auto;\">\n    <h2 style=\"color: #012638; font-size: 32px; font-weight: 700; text-align: center; margin: 0 0 16px;\">Our herbal formulations available for private label</h2>\n    <p style=\"color: #555; font-size: 17px; text-align: center; max-width: 760px; margin: 0 auto 48px;\">A selection of our existing herbal supplement line, available for private label today. Schedule a consultation for the full catalog and custom options.</p>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;\">\n      <div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M8.59 12.41a6 6 0 0 1 8.49-8.49l-1.06 1.06m-4.94 11.42L8.59 12.41m6.36 6.36-3.32-3.32m-1.4-1.4a6 6 0 0 0-3.74 1.43A6 6 0 0 0 4 21l1.5-1.5m11.13-11.13L21 4\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 8px;\">GREENS</p>\n      <h3 style=\"color: #012638; font-size: 18px; font-weight: 700; margin: 0 0 8px;\">Spectra Greens™</h3>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0 0 16px;\">Comprehensive greens blend with synergistic herbs and antioxidants for daily wellness.</p>\n      <div><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Greens</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Antioxidants</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">30 Servings</span></div>\n    </div><div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M21 8.25c0-2.49-2.02-4.5-4.5-4.5-1.83 0-3.4 1.09-4.13 2.66A4.49 4.49 0 0 0 7.5 3.75 4.5 4.5 0 0 0 3 8.25c0 6.97 9 12 9 12s9-5.03 9-12Z\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 8px;\">CARDIO</p>\n      <h3 style=\"color: #012638; font-size: 18px; font-weight: 700; margin: 0 0 8px;\">BP Elite™</h3>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0 0 16px;\">Herbal blend formulated to support healthy blood pressure and circulation.</p>\n      <div><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Botanicals</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Cardiovascular</span></div>\n    </div><div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M9 12.75 11.25 15 15 9.75M21 12c0 5.31-3.69 9.76-8.65 10.95a.84.84 0 0 1-.4.05.94.94 0 0 1-.41-.05A11.25 11.25 0 0 1 3 12V5.99c0-.46.31-.87.74-1.05A23.95 23.95 0 0 1 12 3a23.95 23.95 0 0 1 8.26 1.94c.43.18.74.59.74 1.05V12Z\"/></svg>\n      </div>\n      <p style=\"color: #6BA644; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; margin: 0 0 8px;\">DIGESTIVE</p>\n      <h3 style=\"color: #012638; font-size: 18px; font-weight: 700; margin: 0 0 8px;\">Candid-Away™</h3>\n      <p style=\"color: #555; font-size: 14px; line-height: 1.55; margin: 0 0 16px;\">Botanical formulation supporting healthy gut flora balance.</p>\n      <div><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Botanicals</span><span style=\"display: inline-block; background: #f7f7f6; color: #012638; font-size: 12px; padding: 4px 10px; border-radius: 100px; margin: 0 4px 6px 0;\">Digestive</span></div>\n    </div><div style=\"background: white; border-radius: 8px; padding: 28px 26px; border: 1px solid #ebebe8; transition: box-shadow .2s;\">\n      <div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #c9dbe2; border-radius: 10px; margin: 0 0 16px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#012638\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:24px;height:24px;\"><path d=\"M9.81 4.94 9 2.25l-.81 2.69a4.5 4.5 0 0 1-3 3L2.5 8