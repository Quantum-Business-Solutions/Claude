cssClass": "", "cssId": "", "cssStyle": "", "label": "module_6", "name": "module_6", "params": {"css_class": "dnd-module", "module_id": 218944099156}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_7", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_7", "name": "module_7", "params": {"answer_size": 15, "css_class": "dnd-module", "headline_lh": "normal", "headline_size": 32, "items": [{"answer": "We reply within one business day with either a direct quote (if your request is specific enough to price accurately) or a scoping conversation request (if we need more detail). Most requests need a brief follow-up to get pricing right.", "question": "What happens after I submit a quote request?"}, {"answer": "No. Quotes are free and non-binding. We give you transparent pricing so you can evaluate fit. There's no commitment until you sign a Private Label Agreement, which happens later in the process.", "question": "Will I be asked to sign anything to get pricing?"}, {"answer": "Yes. For initial pricing we need to know: which formulations interest you, what quantities, what packaging. We don't need to know your customer acquisition strategy or financial plan to price a manufacturing engagement.", "question": "Can I get pricing without disclosing my full business plan?"}, {"answer": "Most quotes are valid for 90 days. Ingredient costs can fluctuate (especially for botanicals subject to seasonal pricing), so longer-validity quotes may carry adjustment language. We're transparent about which line items can move and which are locked.", "question": "How long is a quote valid for?"}, {"answer": "Manufacturing quotes include production, quality testing, certificates of analysis, label printing, and bottling. Shipping to your fulfillment location is quoted separately because it depends on quantity, destination, and shipping method. We can also provide warehousing and fulfillment options as a separate line.", "question": "Do quotes include shipping and fulfillment?"}], "max_width": 820, "module_id": 218940115739, "open_first": false, "question_size": 17, "section_eyebrow": "", "section_headline": "Frequently asked questions", "section_subhead": "<p style=\"color: #555; font-size: 17px; line-height: 27px\">None</p>", "style": {"background_color": {"color": "#F7F7F6", "opacity": 100}, "padding": {"padding_bottom": 80, "padding_top": 80}}, "text_color": "dark"}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_8", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_8", "name": "module_8", "params": {"css_class": "dnd-module", "module_id": 218942529652}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, "linkRelCanonicalUrl": "", "metaDescription": "Request transparent private label supplement pricing. Tell us what you are planning and we will respond within one business day.", "name": "Private Label - Page - Request a Quote", "pageRedirected": false, "publicAccessRules": [], "publicAccessRulesEnabled": false, "publishDate": "1970-01-01T00:00:00Z", "published": false, "slug": "en/pl-demo-request-quote", "state": "DRAFT", "subcategory": "site_page", "templatePath": "Private Label/Templates/Page - DND.html", "translations": {}, "updatedAt": "2026-08-30T16:58:45.981Z", "updatedById": "52613719", "url": "https://info.davincilabs.com/en/pl-demo-request-quote", "useFeaturedImage": false, "widgetContainers": {}, "widgets": {}}