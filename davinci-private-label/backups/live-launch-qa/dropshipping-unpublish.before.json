      "rows": [
       {
        "0": {
         "cells": [],
         "cssClass": "",
         "cssId": "",
         "cssStyle": "",
         "label": "module_5",
         "name": "module_5",
         "params": {
          "body_color": {
           "color": "#555555",
           "opacity": 100
          },
          "body_size": 15,
          "card_align": "left",
          "card_density": "standard",
          "card_style": "card",
          "cards": [
           {
            "content": "<p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">The best providers use premium ingredients from trustworthy suppliers and can prove it. Ask for certificates of analysis and ingredient sourcing documentation.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "src": ""
            },
            "title": "Premium ingredient quality"
           },
           {
            "content": "<p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Multiple quality tests at multiple stages, not just at the end. Look for FDA-registered facilities and GMP, NSF, or SQF certifications.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "src": ""
            },
            "title": "Quality assurance throughout production"
           },
           {
            "content": "<p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Your provider needs to keep up when your marketing works. Look for proven production scaling and a fulfillment infrastructure that handles volume spikes.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "src": ""
            },
            "title": "Flexibility and scaling capacity"
           },
           {
            "content": "<p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Current Good Manufacturing Practices are non-negotiable. Compliance protects your brand from FDA action and protects your customers from getting hurt.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "src": ""
            },
            "title": "Adherence to CGMP regulations"
           }
          ],
