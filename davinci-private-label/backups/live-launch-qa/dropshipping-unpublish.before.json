           },
           "padding": {
            "padding_bottom": 30,
            "padding_top": 70
           }
          },
          "subhead": "<p style=\"color: #333; font-size: 17px; line-height: 1.65\">Not every provider offers true dropshipping. Use this checklist before you commit.</p>",
          "subhead_color": {
           "color": "#333333",
