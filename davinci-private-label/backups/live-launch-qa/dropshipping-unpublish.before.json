            "opacity": 100
           },
           "padding": {
            "padding_bottom": 30,
            "padding_top": 70
           }
          },
          "subhead": "<p style=\"color: #333; font-size: 17px; line-height: 1.65\">Lower risk, faster turnaround, more time on customer service and marketing.</p>",
          "subhead_color": {
           "color": "#333333",
           "opacity": 100
          },
          "subhead_size": 17,
          "text_color": "dark"
         },
