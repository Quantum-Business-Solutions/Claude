         "params": {
          "align": "center",
          "css_class": "dnd-module",
          "eyebrow": "STEP 01 THE ADVANTAGE",
          "headline": "Why dropshipping works for private label supplements.",
          "headline_lh": "1.2",
          "headline_size": 34,
          "max_width": 900,
          "module_id": 218940115771,
          "style": {
