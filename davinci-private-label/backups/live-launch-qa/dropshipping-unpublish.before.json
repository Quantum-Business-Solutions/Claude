          "align": "center",
          "css_class": "dnd-module",
          "eyebrow": "STEP 02 VENDOR CRITERIA",
          "headline": "What to look for in a dropshipping supplement partner.",
          "headline_lh": "1.2",
          "headline_size": 34,
          "max_width": 900,
          "module_id": 218940115771,
          "style": {
           "background_color": {
            "color": "#FFFFFF",
