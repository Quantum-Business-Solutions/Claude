}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_1", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_1", "name": "module_1", "params": {"align": "center", "body_size": 17, "content": "<h2 style=\"color: #012638; font-size: 32px; font-weight: bold; margin: 0 0 12px;\">Start your label here.</h2>\n    <p style=\"color: #555; font-size: 17px; margin: 0 0 36px;\">Choose your template and fill out the form. Our design team will take it from there.</p>\n    <img src=\"https://4087538.fs1.hubspotusercontent-na1.net/hubfs/4087538/Private_Label_Templates.jpg\" alt=\"Private Label Templates\" style=\"width: 100%; max-width: 860px; height: auto; border-radius: 8px; box-shadow: 0 8px 30px rgba(1,38,56,.12);\">", "css_class": "dnd-module", "heading_size": 32, "max_width": 860, "module_id": 218940115784, "style": {"background_color": {"color": "#F7F7F6", "opacity": 100}, "padding": {"padding_bottom": 40, "padding_top": 80}}, "text_color": "dark", "top_border": false}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_2", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_2", "name": "module_2", "params": {"css_class": "dnd-module", "form": {"form_id": "df8b7a41-df30-4e60-9b8a-d76b651bab20", "form_type": "HUBSPOT", "message": "<p>Thanks for your label selections. Our design team will be in touch shortly.</p>", "response_type": "inline"}, "module_id": 1155238, "title": "Start your Label Here!"}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_3", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_3", "name": "module_3", "params": {"align": "left", "body_size": 18, "content": "<h2 style=\"color: #012638; font-size: 32px; font-weight: bold; line-height: 1.25; margin: 0 0 26px\">Don't have a designer? Our team becomes yours.</h2><p>Most private label clients fall into one of two camps. Either they have brand assets they want to apply to a label template, or they're building their brand from scratch and need help with everything from logo to finished design. We work with both.</p><p>Our in-house design team is included with your private label engagement. No separate design retainer, no hourly design fees on top of product costs. You get expert label design built around regulatory requirements and proven shelf appeal.</p>", "css_class": "dnd-module", "heading_size": 32, "max_width": 810, "module_id": 218940115784, "style": {"background_color": {"color": "#FFFFFF", "opacity": 100}, "padding": {"padding_bottom": 50, "padding_top": 80}}, "text_color": "dark", "top_border": false}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_4", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_4", "name": "module_4", "params": {"body_color": {"color": "#012638", "opacity": 100}, "body_size": 15, "card_align": "left", "card_density": "standard", "card_style": "plain", "cards": [{"content": "<p style=\"color: #012638; font-size: 15px; line-height: 1.6; margin: 0; opacity: .85;\">Direct access to over 190 doctor-formulated supplements with low minimums and no set-up fees. Choose what fits your audience and your timeline.</p>", "number_or_eyebrow": "01", "title": "BUILD YOUR PRODUCT LINE"}, {"content": "<p style=\"color: #012638; font-size: 15px; line-height: 1.6; margin: 0; opacity: .85;\">Use your existing logo, customize a new label, or pick from our professional templates. Our in-house design team brings your vision to life.</p>", "number_or_eyebrow": "02", "title": "DESIGN YOUR BRAND"}, {"content": "<p style=\"color: #012638; font-size: 15px; line-height: 1.6; margin: 0; opacity: .85;\">Launch in as little as 3 to 4 weeks after approving your labels. Every product passes rigorous quality assurance before it ships.</p>", "number_or_eyebrow": "03", "title": "START SELLING FAST"}], "css_class": "dnd-module", "gap": 40, "header_width": 1100, "headline_lh": "1.2", "headline_size": 32, "max_width": 1100, "min_column_width": 260, "module_id": 218940115759, "number_size": 56, "section_eyebrow": "HOW IT WORKS", "section_headline": "Get to market faster with a partner who handles the heavy lifting.", "section_subhead": "", "style": {"background_color": {"color": "#C9DBE2", "opacity": 100}, "padding": {"padding_bottom": 70, "padding_top": 70}}, "subhead_size": 17, "subhead_width": 0, "text_color": "dark", "title_lh": "1.3", "title_size": 19, "title_style": "eyebrow-caps"}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_5", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_5", "name": "module_5", "params": {"align": "center", "css_class": "dnd-module", "eyebrow": "HOW IT WORKS", "headline": "A streamlined process from logo to launch.", "headline_lh": "1.2", "headline_size": 34, "max_width": 900, "module_id": 218940115771, "style": {"background_color": {"color": "#F7F7F6", "opacity": 100}, "padding": {"padding_bottom": 30, "padding_top": 70}}, "subhead": "", "subhead_color": {"color": "#555555", "opacity": 100}, "subhead_size": 17, "text_color": "dark"}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_6", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_6", "name": "module_6", "params": {"body_color": {"color": "#555555", "opacity": 100}, "body_size": 15, "card_align": "left", "card_density": "standard", "card_style": "card", "cards": [{"content": "<p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">We start with a short conversation about your brand: who your customer is, what feeling you want the label to evoke, what colors and aesthetic you're drawn to, and what your existing brand assets look like (if any).</p>", "icon": {"alt": "", "loading": "lazy", "src": "https://www.pettechlabs.com/hubfs/Praxera/discovery-strategy-ink.png"}, "title": "1. Brand discovery call"}, {"content": "<p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Choose from 20+ professionally designed label templates as your starting point. Each template is built to highlight your branding while meeting all FDA labeling requirements. Pick one and we customize from there.</p>", "icon": {"alt": "", "loading": "lazy", "src": "https://www.pettechlabs.com/hubfs/Praxera/product-selection-design-ink.png"}, "title": "2. Template selection"}, {"content": "<p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Our designers create your custom label, then iterate based on your feedback. Typical revision cycles take 3 to 5 business days. We don't move to print until you're 100% happy with the proof.</p>", "icon": {"alt": "", "loading": "lazy", "src": "https://www.pettechlabs.com/hubfs/Praxera/design-your-brand-ink.png"}, "title": "3. Design iteration"}, {"content": "<p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Final files go to print after your written approval. This is when our 3-to-4-week production clock starts. Approve labels Monday, and your private label product ships in less than a month.</p>", "icon": {"alt": "", "loading": "lazy", "src": "https://www.pettechlabs.com/hubfs/Praxera/label-approval-ink.png"}, "title": "4. Print-ready file & label approval"}], "css_class": "dnd-module", "gap": 28, "header_width": 1100, "headline_lh": "1.25", "headline_size": 32, "max_width": 1100, "min_column_width": 536, "module_id": 218940115759, "section_eyebrow": "", "section_headline": "", "section_subhead": "", "style": {"background_color": {"color": "#F7F7F6", "opacity": 100}, "padding": {"padding_bottom": 70, "padding_top": 20}}, "subhead_size": 17, "subhead_width": 0, "text_color": "dark", "title_lh": "normal", "title_size": 19, "title_style": "heading"}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_7", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_7", "name": "module_7", "params": {"body_size": 16, "content": "<p>Most private label supplement suppliers&nbsp;stop at putting your logo on a generic label template. We go further. If you don't have a logo yet, we'll design one. If your brand needs typography and color guidance, we provide it. If you want to align labels across multiple SKUs into a cohesive product line, that's where we shine. Our designers think about your entire shelf presence, not just a single bottle.</p>", "css_class": "dnd-module", "eyebrow": "WHAT YOU GET", "gap": 60, "headline": "A complete brand identity, not just a label.", "headline_size": 32, "image": {"alt": "Brand identity design", "loading": "lazy", "src": "https://info.davincilabs.com/hubfs/private-label/DV_PL_BuildSuppBrand.jpg"}, "image_radius": 6, "image_shadow": false, "image_side": "right", "max_width": 1100, "module_id": 218939846527, "ratio": "1fr 1fr", "style": {"background_color": {"color": "#012638", "opacity": 100}, "padding": {"padding_bottom": 90, "padding_top": 90}}, "text_color": "light"}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_8", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_8", "name": "module_8", "params": {"align": "center", "css_class": "dnd-module", "eyebrow": "WHAT WE NEED FROM YOU", "headline": "To get started, gather these items.", "headline_lh": "1.2", "headline_size": 34, "max_width": 900, "module_id": 218940115771, "style": {"background_color": {"color": "#FFFFFF", "opacity": 100}, "padding": {"padding_bottom": 30, "padding_top": 70}}, "subhead": "", "subhead_color": {"color": "#555555", "opacity": 100}, "subhead_size": 17, "text_color": "dark"}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_9", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_9", "name": "module_9", "params": {"align": "left", "body_size": 16, "content": "<div style=\"display: flex; align-items: flex-start; gap: 14px; margin: 0 0 18px;\">\n      <div style=\"flex-shrink: 0; width: 26px; height: 26px; background: #6BA644; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700;\">&#10003;</div>\n      <p style=\"color: #333; font-size: 16px; l