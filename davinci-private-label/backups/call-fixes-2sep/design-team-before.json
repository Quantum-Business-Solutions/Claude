{"align": "left", "body_size": 17, "content": "<p>If you have an in-house designer or an agency partner, we can work with their output directly. You'll need to follow our file format and color requirements to avoid rework delays.</p>", "css_class": "dnd-module", "heading_size": 32, "max_width": 800, "module_id": 218940115784, "style": {"background_color": {"color": "#F7F7F6", "opacity": 100}, "padding": {"padding_bottom": 70, "padding_top": 10}}, "text_color": "dark", "top_border": false}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_12", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_12", "name": "module_12", "params": {"button_padding": "14px 32px", "button_size": 15, "buttons": [{"link": {"open_in_new_tab": false, "url": {"href": "#get-started", "type": "EXTERNAL"}}, "style": "dark", "text": "Start Your Label"}], "content": "<p style=\"color: #012638; font-size: 19px; font-weight: 600; line-height: 1.5\">Ready to start designing your label? Most clients have a print-ready label within 2 weeks.</p>", "content_color": {"color": "#012638", "opacity": 100}, "content_size": 19, "content_weight": "600", "css_class": "dnd-module", "eyebrow": "", "headline": "", "headline_lh": "1.25", "headline_size": 32, "max_width": 800, "module_id": 218940115731, "style": {"background_color": {"color": "#C9DBE2", "opacity": 100}, "padding": {"padding_bottom": 50, "padding_top": 50}}, "text_color": "dark"}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_13", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "",