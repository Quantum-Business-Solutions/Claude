 the pace that works for you.", "question": "What if I'm not ready to commit after the call?"}], "max_width": 820, "module_id": 218940115739, "open_first": false, "question_size": 17, "section_eyebrow": "", "section_headline": "Frequently asked questions", "section_subhead": "<p style=\"color: #555; font-size: 17px; line-height: 27px\">None</p>", "style": {"background_color": {"color": "#F7F7F6", "opacity": 100}, "padding": {"padding_bottom": 80, "padding_top": 80}}, "text_color": "dark"}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}, {"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "name": "column_9", "params": {"css_class": "dnd-column"}, "rowMetaData": [{"cssClass": "dnd-row"}], "rows": [{"0": {"cells": [], "cssClass": "", "cssId": "", "cssStyle": "", "label": "module_9", "name": "module_9", "params": {"css_class": "dnd-module", "module_id": 218942529652}, "rowMetaData": [], "rows": [], "type": "module", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}], "type": "cell", "w": 0, "x": 0}}