    "value": "Praxera template - draft, not for sending"
   },
   "px_body": {
    "body": {
     "hs_enable_module_padding": false,
     "html": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"padding:0px 32px 0px;\"><p style=\"margin:0 0 12px;font-family:Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#76BC43;\">The short version</p><h2 style=\"margin:0 0 18px;font-family:Georgia,'Times New Roman',serif;font-size:26px;line-height:1.22;color:#231F20;font-weight:normal;\">A new name for a programme you already know</h2><p style=\"margin:0 0 15px;font-family:Helvetica,Arial,sans-serif;font-size:15px;line-height:1.75;color:#44483F;\">Same formulations. Same facility. Same team on the phone. What changes is the name on the programme and the standard of the experience around it &mdash; a clearer catalogue, faster quoting, and a design service that takes your label from sketch to shelf.</p><p style=\"margin:0;font-family:Helvetica,Arial,sans-serif;font-size:15px;line-height:1.75;color:#44483F;\">Below: three questions we are asked in almost every first call.</p></td></tr></table>",
     "module_id": 1155639
    },
    "type": "module"
   },
   "px_cta": {
    "body": {
     "hs_enable_module_padding": false,
     "html": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"padding:0px 32px 0px;\"><div style=\"text-align:left;font-family:Helvetica,Arial,sans-serif;\"><a href=\"https://www.praxerasupplements.com/book-consultation\" style=\"background:#76BC43;color:#ffffff;text-decoration:none;padding:15px 34px;font-size:14px;font-weight:bold;letter-spacing:.04em;display:inline-block;border-radius:2px;\">Book a consultation</a></div></td></tr></table>",
     "module_id": 1155639
    },
    "type": "module"
   },
   "px_footer": {
    "body": {
     "hs_enable_module_padding": false,
     "html": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"padding:0px 32px 0px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"border-top:1px solid #E4E7E0;padding-top:18px;font-family:Helvetica,Arial,sans-serif;font-size:11px;line-height:1.7;color:#7B8177;\"><strong style=\"color:#44483F;letter-spacing:.08em;\">PRAXERA</strong><br>Vermont, U.S.A.<br><span style=\"color:#9AA093;\">Draft placeholder built by Quantum Business Solutions &mdash; do not send.</span></td></tr></table></td></tr></table>",
     "module_id": 1155639
    },
    "type": "module"
   },
   "px_hero": {
    "body": {
     "hs_enable_module_padding": false,
     "html": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;\"><tr><td style=\"padding:0px 32px 0px;\"><p style=\"margin:0 0 12px;font-family:Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#BFDF97;\">Issue 01 &nbsp;&middot;&nbsp; Your brand. Our standards.</p><h1 style=\"margin:0 0 14px;font-family:Georgia,'Times New Roman',serif;font-size:31px;line-height:1.16;color:#ffffff;font-weight:normal;max-width:430px;\">Introducing Praxera</h1><p style=\"margin:0;font-family:Helvetica,Arial,sans-serif;font-size:15px;line-height:1.65;color:#BFDF97;max-width:430px;\">Private label supplements for the brands you&rsquo;re building &mdash; formulated in Vermont, made to your label, backed by fifty years of manufacturing standards.</p></td></tr></table>",
     "module_id": 1155639
    },
    "type": "module"
   },
