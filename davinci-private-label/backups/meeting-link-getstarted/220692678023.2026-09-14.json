     },
     "html": "<div>\n<div>\n<div>\n<div>\n<p style=\"text-align: center; font-size: 13px; line-height: 125%;\"><span style=\"color: #000000; font-family: Helvetica, Arial, sans-serif; letter-spacing: 2px;\">NO FILLERS, BINDERS OR ARTIFICIAL FLAVORS</span></p>\n</div>\n</div>\n</div>\n</div>",
