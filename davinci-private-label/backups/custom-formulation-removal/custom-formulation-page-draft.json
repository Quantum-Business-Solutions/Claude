          "cards": [
           {
            "content": "<p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Same R&amp;D process that builds Praxera's own product line. Doctor formulators, clinical research, ingredient sourcing, prototype development, and stability testing.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "src": ""
            },
            "title": "Doctor-formulated R&D"
           },
           {
            "content": "<p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Custom formulations belong to your brand. They are not added to our private label catalog. Competitors cannot copy them from us.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "src": ""
            },
            "title": "Proprietary ownership"
           },
           {
            "content": "<p style=\"color: #555; font-size: 15px; line-height: 1.6; margin: 0;\">Capsules, tablets, powders, softgels, chewables, liquids, oral sprays. Format selection driven by your formulation needs.</p>",
            "icon": {
             "alt": "",
             "loading": "lazy",
             "src": ""
            },
            "title": "Full format flexibility"
           }
