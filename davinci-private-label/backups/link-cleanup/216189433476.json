          "eyebrow": "ABOUT US",
          "eyebrow_color": "heading",
          "eyebrow_size": 13,
          "headline": "<h1>50 years of supplement expertise behind every brand we partner with.</h1>",
          "headline_size": 48,
          "max_width": 900,
          "module_id": 218939846507,
          "style": {
           "background_color": {
