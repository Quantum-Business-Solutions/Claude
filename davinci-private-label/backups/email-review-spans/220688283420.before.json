   "module_153978623046969": {
    "body": {
     "hs_enable_module_padding": true,
     "html": "<div>{{ personalization_token('contact.firstname', 'Healthcare Professional') }},</div>\n<p>Thanks for your interest in Private Label supplements with <span style=\"background:#FFF3CD;border-bottom:2px solid #8A6300;\" data-praxera-review=\"brand\">Praxera</span>.</p>\n<p>&nbsp;</p>\n<div data-olk-copy-source=\"MessageBody\">We help healthcare professionals launch their own branded product lines using the same clinically formulated supplements trusted by 30,000+ practitioners.</div>\n<div data-olk-copy-source=\"MessageBody\">&nbsp;</div>\n<div>Your next step is a quick discovery call with me. I\u2019d love to learn more about your goals and walk you through how the process works. It\u2019s a quick, informal conversation with no pressure.</div>\n<div>&nbsp;</div>\n<div>If you\u2019d like a preview of what to expect, you can take a look at our <a href=\"https://www.praxerasupplements.com/en/pl-demo-onboarding-guide\">Private Label Client Onboarding Guide.</a>&nbsp;It walks through every step from discovery call to first shipment.</div>\n<p>&nbsp;</p>\n<p>Ready to get started? Please grab a time that works for you here:</p>\n<p>{{ personalization_token('contact.hubspot_owner_id.meetings_link', 'My Calendar') }}</p>\n<div>\n<p>&nbsp;</p>\n<div>Thank you, and I&nbsp;look forward to working with you!&nbsp;</div>\n<div>&nbsp;</div>\n<div><em>- {{ contact.hubspot_owner_id.fullname }}</em></div>\n</div>",
     "module_id": 1155639
    },
