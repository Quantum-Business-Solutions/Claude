   "module_16783031312213": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<h2 style=\"font-size: 18px; line-height: 175%;\"><span style=\"color: #76bc43;\">Remind Your Patients that Every Day is CARDIO Day</span></h2>\n<p><span style=\"color: #000000;\">In today's age nobody can deny that cardio is important for everyday health. Still, many people ask, how often should I be doing a cardio-intensive exercise? This article seeks to answer that question by exploring the important dynamic of rest days and cardio days.&nbsp;&nbsp;</span></p>\n<p>&nbsp;</p>\n<p style=\"font-weight: bold;\"><span style=\"color: #000000;\">Check out <a href=\"https://www.praxerasupplements.com/\" style=\"color: #000000;\" rel=\"noopener\">the article</a>, and more importantly, share it across your socials to engage with your patients. You can even copy and paste the above blurb!</span></p>\n<ul></ul>",
     "module_id": 1155639
    },
    "child_css": {},
    "css": {},
    "id": "module_16783031312213",
    "label": null,
