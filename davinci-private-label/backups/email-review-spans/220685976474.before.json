   "module_16783038206636": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<h2 style=\"font-size: 18px; line-height: 175%;\"><span style=\"color: #76bc43;\">Support for a Healthy Heart</span></h2>\n<p><span style=\"color: #000000;\">Regardless of how physically active your patients might be, providing the proper support for the heart is always beneficial. For this month, we have two products that directly support cardiovascular functions, along with other benefits!* As a member of <em><span style=\"font-weight: bold;\"><span style=\"background:#FFF3CD;border-bottom:2px solid #8A6300;\" data-praxera-review=\"brand\">Praxera</span> for Doctors</span></em><span style=\"font-weight: bold;\">&nbsp;</span><span style=\"font-weight: normal;\">you can provide these supplements with low minimum orders and free shipping.</span></span></p>\n<ul></ul>",
     "module_id": 1155639
    },
