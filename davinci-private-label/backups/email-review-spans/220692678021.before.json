   "module_16049493631818": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "20px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "25px"
     },
     "html": "<p style=\"font-size: 15px; line-height: 150%; text-align: left;\"><span style=\"color: #ffffff; font-family: Helvetica, Arial, sans-serif;\"><span style=\"font-weight: normal; color: #000000;\">Hi {{ contact.firstname }},</span></span><span style=\"color: #000000;\">&nbsp;</span></p>\n<p style=\"font-size: 15px; line-height: 150%; text-align: left;\">&nbsp;</p>\n<p style=\"font-size: 15px; line-height: 150%; text-align: left;\"><span style=\"color: #000000;\"><span style=\"color: #6ca439;\"><a href=\"https://www.praxerasupplements.com/blog/private-label-supplements-how-to-make-money\" style=\"font-weight: bold; color: #6ca439;\" rel=\"noopener\">Private label supplements</a><span style=\"font-weight: bold;\"> </span></span>are a true win-win for business-minded individuals by getting your clients the results they need and offer lucrative revenue opportunities.</span></p>\n<p style=\"font-size: 15px; line-height: 150%; text-align: left;\">&nbsp;</p>\n<p style=\"font-size: 15px; line-height: 150%; text-align: left;\"><span style=\"color: #000000;\">With <span style=\"background:#FFF3CD;border-bottom:2px solid #8A6300;\" data-praxera-review=\"brand\">Praxera</span>, your private label supplement business can be especially profitable, as we offer low order minimums and start-up costs. This allows you to try out a small number of products right off the bat, with little to no risk.</span></p>\n<p style=\"font-size: 15px; line-height: 150%; text-align: left;\">&nbsp;</p>\n<p style=\"font-size: 15px; line-height: 150%; text-align: left;\"><span style=\"color: #000000;\">Once you determine which formulas are the most successful for your clientele, you have control over how fast you grow your business. As you glean credibility from your private label formulas, your active and passive revenue streams also continue to grow.</span></p>",
     "module_id": 1155639
    },
    "child_css": {},
    "css": {},
    "id": "module_16049493631818",
    "label": null,
    "module_id": 1155639,
