   },
   "module_16123736011481": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<p>Hi&nbsp;{{ contact.firstname }},</p>\n<p>Finding a private label manufacturer that cares about your success is critical to launching your own private label supplement brand.</p>\n<p><br><span style=\"background:#FFF3CD;border-bottom:2px solid #8A6300;\" data-praxera-review=\"brand\">Praxera</span> is a <span style=\"background:#F8DDD9;border-bottom:2px solid #9B3B31;\" data-praxera-review=\"claim\">family-owned company</span>, dedicated to higher integrity and superior-quality for over 50 years. Choosing <span style=\"background:#FFF3CD;border-bottom:2px solid #8A6300;\" data-praxera-review=\"brand\">Praxera</span> as your partner in private label supplements translates to low minimums, quick turnaround times, and no set-up fees.</p>",
     "module_id": 1155639
    },
