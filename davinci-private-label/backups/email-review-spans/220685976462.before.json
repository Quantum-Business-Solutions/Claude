   "module_16147354540445": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<p style=\"font-weight: normal;\">At <span style=\"background:#FFF3CD;border-bottom:2px solid #8A6300;\" data-praxera-review=\"brand\">Praxera</span>, <span style=\"background:#F8DDD9;border-bottom:2px solid #9B3B31;\" data-praxera-review=\"claim\">we guarantee</span> total truth in labeling, meaning that <span style=\"background:#F8DDD9;border-bottom:2px solid #9B3B31;\" data-praxera-review=\"claim\">our products contain</span> the purest and most potent ingredients.&nbsp;</p>\n<p style=\"font-weight: normal;\">&nbsp;</p>\n<p style=\"font-weight: normal;\">By offering just a few products or an entire line of quality nutritional supplements, you can add a significant revenue stream to your clinic or E-commerce business. <span style=\"color: #6ca439; font-weight: bold;\"><a href=\"https://www.praxerasupplements.com/en/pl-demo-about\" style=\"color: #6ca439;\" rel=\"noopener\">Offering your own professional grade products</a></span> builds client loyalty as they see heightened results and improvements, boosts referrals, and cements the doctor-patient relationship.&nbsp;<br><br></p>\n<p><strong>Just Three Steps to Get Started:</strong></p>\n<ul>\n<li>Select a formula</li>\n<li>Select one of our proven brand designs or customize your own</li>\n<li>Receive your first order shortly after!</li>\n</ul>",
     "module_id": 1155639
    },
