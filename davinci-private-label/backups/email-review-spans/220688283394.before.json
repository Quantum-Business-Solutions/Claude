   "module_16783038206636": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<h2 style=\"font-size: 18px; line-height: 175%;\"><span style=\"color: #76bc43;\">Support for the Immune System</span></h2>\n<p><span style=\"color: #000000;\">It wouldn't be our monthly email without a few product recommendations. This time around we have two supplements that provide powerful support for the immune system. These options are great for your patients that want to take a proactive approach in supporting their immune and every day health.</span></p>\n<p>&nbsp;</p>\n<p><span style=\"color: #000000;\">In case you didn't see it before, we want to remind you that as a member of <span style=\"font-weight: normal;\"><em><span style=\"font-weight: bold;\"><span style=\"background:#FFF3CD;border-bottom:2px solid #8A6300;\" data-praxera-review=\"brand\">Praxera</span></span> </em>you can provide these supplements with <span style=\"font-weight: bold;\">low minimum orders and free shipping.</span></span></span></p>\n<ul></ul>",
     "module_id": 1155639
    },
