   "hs_email_body_old1": {
    "body": {
     "hs_enable_module_padding": true,
     "html": "<p>Partnering with <span style=\"background:#FFF3CD;border-bottom:2px solid #8A6300;\" data-praxera-review=\"brand\">Praxera</span> to create a <span style=\"color: #6ca439;\"><a href=\"https://www.praxerasupplements.com/blog/benefits-of-selling-private-label-supplements\" style=\"font-weight: bold; color: #6ca439;\" rel=\"noopener\">private label supplement line can offer the following benefits</a>:</span></p>",
