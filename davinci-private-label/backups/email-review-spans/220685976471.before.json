   "module_16783031312213": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<h2><span style=\"color: #76bc43;\">Get in Touch With Your Rep!</span></h2>\n<p><span style=\"color: #000000;\">To start things off, know that you are not in this alone! As a member of our program, you have a dedicated representative that is here to answer all your questions and help out in whatever way they can. If you haven't heard from them, don't be afraid to reach out. Their name is <span style=\"font-weight: bold;\">{{ contact.hubspot_owner_id.fullname }}</span> and they can be reached at <span style=\"font-weight: bold;\">{{ contact.hubspot_owner_id.email }}</span>. If you need to schedule a time to speak with them you can use their meeting link, <span style=\"font-weight: bold;\">{{ contact.hubspot_owner_id.meetings_link }}</span>.</span></p>\n<ul></ul>",
     "module_id": 1155639
    },
