   "module_16783031312213": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<h2 style=\"font-size: 18px; line-height: 175%;\"><span style=\"color: #76bc43;\">Tell Your Patients that Health Starts with a Gut Feeling</span></h2>\n<p><span style=\"color: #000000;\">There is no surprise that poor gut health can be related to bloating and indigestion, but did you know it can also impact fatigue, hormonal balance, and joint discomfort? The good news is that maintaining a healthy gut can lead to a variety of benefits. One way to support your gut is with L-Glutamine. Check out our article to read more about it.</span></p>\n<p>&nbsp;</p>\n<p style=\"font-weight: bold;\"><span style=\"color: #000000;\">Like last time, read <a href=\"https://www.praxerasupplements.com/\" style=\"color: #000000;\" rel=\"noopener\">our article</a> and share it on your social pages to connect with your patients.</span></p>\n<ul></ul>",
     "module_id": 1155639
    },
    "child_css": {},
    "css": {},
