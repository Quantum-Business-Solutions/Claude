   "module_16783038206636": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<h2 style=\"font-size: 18px; line-height: 175%;\"><span style=\"color: #76bc43;\">Support for a Healthy Gut</span></h2>\n<p><span style=\"color: #000000;\">Like with all bodily functions, each person might need a different supplement that works for them. For your patients that are interested in doing more to support the gut health, we have two supplements that can help them regulate their GI tract.*</span></p>\n<p>&nbsp;</p>\n<p><span style=\"color: #000000;\">Don't forget, as a member of <span style=\"font-weight: bold;\"><em><span style=\"background:#FFF3CD;border-bottom:2px solid #8A6300;\" data-praxera-review=\"brand\">Praxera</span></em>&nbsp;</span><span style=\"font-weight: normal;\">you can provide these supplements with<span style=\"font-weight: bold;\"> low minimum orders and free shipping.</span></span></span></p>\n<ul></ul>",
     "module_id": 1155639
