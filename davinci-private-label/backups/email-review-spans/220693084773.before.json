   "hs_email_body_old1": {
    "body": {
     "hs_enable_module_padding": true,
     "html": "<p><span style=\"font-weight: bold;\">Next,</span> if you're not familiar with selling supplements, you'll need to learn how to start your private label supplement business to maximize your profits and customer loyalty. The field of private label supplements has taken off over the last couple of years, so it's essential you're prepared with the basic information you need to get up and running.&nbsp;</p>\n<p>&nbsp;</p>\n<p><em>We've put together an easy-to-follow, <a href=\"https://www.praxerasupplements.com/blog/how-do-i-start-a-private-label-supplement-business\" style=\"font-weight: bold;\" rel=\"noopener\">7-step guide that makes it easy to arm yourself with private label business</a> information.</em></p>",
     "module_id": 1155639
    },
    "child_css": {},
