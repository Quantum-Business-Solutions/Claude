      "alt": "DAV_EcommWeb_TruthInLabeling_2",
      "height": 293,
      "src": "https://f.hubspotusercontent30.net/hubfs/4087538/Emails/DAV_EcommWeb_TruthInLabeling_2.jpg",
      "width": 560
