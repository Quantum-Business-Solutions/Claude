   "module_161142128695811": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<h2 style=\"text-align: center;\"><span style=\"color: #7fbf4b;\"><span style=\"color: #000000;\">PRIVATE LABELING</span> MADE EASY.</span></h2>\n<p><span style=\"color: #000000;\">We offer more than 200 high quality supplements you can use to optimize health outcomes in your customers and </span><span style=\"font-weight: bold; color: #000000;\">confidently brand as your own</span><span style=\"color: #000000;\">. </span></p>\n<p>&nbsp;</p>\n<p><span style=\"color: #000000;\">Private labeling is a great way to build your personal brand and boost revenue. Offering your own line of quality nutritional supplements helps to build client loyalty by encouraging consistent, frequent contact with you and your organization.&nbsp;</span></p>\n<p>&nbsp;</p>\n<p style=\"font-size: 18px; line-height: 175%;\"><span style=\"color: #000000;\"><strong>STEP #1 - CHOOSE WHAT PRODUCTS TO SELL</strong></span></p>\n<ul>\n<li><span style=\"color: #000000;\">Sell your own branded supplements (Over 200 to choose from)</span></li>\n<li><span style=\"color: #000000;\">Low minimum orders (36 Units)</span></li>\n<li><span style=\"color: #000000;\">Drop shipping available</span></li>\n</ul>\n<p style=\"font-size: 18px; line-height: 175%;\"><span style=\"color: #000000;\"><strong>STEP #2 - CUSTOM BRANDING</strong></span></p>\n<ul data-bold=\"inherit\" data-gramm=\"false\">\n<li><span style=\"color: #000000;\">Choose from 15 beautiful label designs, or design your own&nbsp;</span></li>\n<li><span style=\"color: #000000;\">No set up fees</span></li>\n<li><span style=\"color: #000000;\">Quick turnaround</span></li>\n</ul>\n<p style=\"font-size: 18px; line-height: 175%;\"><span style=\"color: #444444;\"><strong>STEP #3 - START SELLING</strong></span></p>\n<ul>\n<li style=\"font-size: 15px; line-height: 175%;\"><span style=\"color: #000000;\">Build a recurring stream of revenue for your business</span></li>\n<li style=\"font-size: 15px; line-height: 175%;\"><span style=\"color: #000000;\">Help your customers access clinically relevant formulas with restorative nutrient levels</span></li>\n</ul>",
     "module_id": 1155639
    },
