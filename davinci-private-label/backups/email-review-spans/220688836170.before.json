   "module_16055505955141": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<p><span style=\"color: #000000;\">Hi {{ contact.firstname }},</span></p>\n<p><span style=\"color: #000000;\">Thank you for your interest in <span style=\"background:#FFF3CD;border-bottom:2px solid #8A6300;\" data-praxera-review=\"brand\">Praxera</span>!</span></p>\n<p>&nbsp;</p>\n<p><span style=\"color: #000000;\">As a wellness professional who is passionate about helping people take charge of their health, </span><span style=\"color: #000000;\">you might appreciate a little insight about our <span style=\"text-decoration: underline;\">why</span> we do what we do and <span style=\"text-decoration: underline;\">what</span> we offer. </span><span style=\"color: #000000;\">Here is what you should know about us:</span></p>\n<ul></ul>",
     "module_id": 1155639
    },
    "child_css": {},
    "css": {},
    "id": "module_16055505955141",
    "label": null,
    "module_id": 1155639,
    "name": "module_16055505955141",
    "order": 3,
    "smart_type": null,
    "styles": {},
    "type": "module"
   },
   "module_16114197042474": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<h2 style=\"text-align: center;\"><span style=\"color: #000000;\">TRUTH <span style=\"color: #7fbf4b;\">IN LABELING</span>.</span></h2>\n<p><span style=\"color: #000000;\">We are a rare breed, here at <span style=\"background:#FFF3CD;border-bottom:2px solid #8A6300;\" data-praxera-review=\"brand\">Praxera</span>. We made a commitment to truth in labeling when we opened our doors more than 50 years ago, and it remains the founding principle behind every formula we offer today.&nbsp;</span></p>\n<p>&nbsp;</p>\n<p><span style=\"color: #000000;\">Many companies out there offer supplements with little nutritional value and plenty of fillers the body doesn't need. </span></p>\n<p>&nbsp;</p>\n<p><span style=\"color: #000000;\">That's not us.</span></p>\n<p>&nbsp;</p>\n<p><span style=\"color: #000000;\">Our customers get:</span></p>\n<ul style=\"list-style-type: circle;\">\n<li><span style=\"color: #000000;\">Therapeutic levels of ingredients and potent formulas that are never watered down</span></li>\n<li><span style=\"color: #000000;\">Natural supplements derived from real nutrients</span></li>\n<li><span style=\"color: #000000;\">Supplements that break barriers and take standards to a higher level</span></li>\n</ul>",
     "module_id": 1155639
    },
    "child_css": {},
    "css": {},
    "id": "module_16114197042474",
    "label": null,
    "module_id": 1155639,
    "name": "module_16114197042474",
    "order": 6,
    "smart_type": null,
    "styles": {},
    "type": "module"
   },
   "module_16114210525766": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
