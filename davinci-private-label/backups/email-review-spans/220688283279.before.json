     "html": "<h2 style=\"text-align: center;\">PRIVATE LABELING&nbsp;<span style=\"color: #76bc43;\">MADE EASY.</span></h2>\n<p style=\"text-align: center;\">We offer <span style=\"font-weight: bold;\">Custom Formulation </span><span style=\"font-weight: normal;\">and</span> more than 200 carefully chosen nutritional supplements so you can confidently optimize your product lines, all under your results-driven personal brand.</p>",
     "module_id": 1155639
    },
    "child_css": {},
    "css": {},
    "id": "module_16524465759264",
    "label": null,
