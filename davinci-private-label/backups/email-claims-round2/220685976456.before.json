   "module_16121289240844": {
    "body": {
     "hs_enable_module_padding": true,
     "hs_wrapper_css": {
      "padding-bottom": "10px",
      "padding-left": "20px",
      "padding-right": "20px",
      "padding-top": "10px"
     },
     "html": "<p><strong>Getting started is simple:</strong></p>\n<ol start=\"1\">\n<li>\n<p>Choose a formula</p>\n</li>\n<li>\n<p>Pick your label style or bring your own</p>\n</li>\n<li>\n<p>Receive your first order and start selling</p>\n</li>\n</ol>\n<p>&nbsp;</p>\n<p>We\u2019re not just a supplier, we\u2019re partners. And we\u2019re ready to help you unlock a whole new revenue stream built around your brand.</p>\n<p>&nbsp;</p>",
     "module_id": 1155639
    },
    "child_css": {},
    "css": {},
    "id": "module_16121289240844",
    "label": null,
    "module_id": 1155639,
    "name": "module_16121289240844",
    "order": 12,
