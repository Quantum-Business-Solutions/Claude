         "label": "module_8",
         "name": "module_8",
         "params": {
          "align": "center",
          "body_size": 24,
          "content": "<div style=\"color: #6ba644; font-size: 72px; line-height: .8; font-family: Georgia, serif; margin: 0 0 -10px;\">\u201c</div>\n<p style=\"color: #012638; font-size: 24px; line-height: 1.45; font-weight: 500; margin: 0 0 32px; font-style: italic;\">Our customers ask hard questions about where their supplements come from. Having Praxera's certifications and certificates of analysis to point to has turned skeptical buyers into repeat customers.</p>\n<p style=\"color: #012638; font-size: 16px; font-weight: bold; margin: 0;\">Private label brand partner</p>\n<p style=\"color: #6ba644; font-size: 13px; font-weight: bold; letter-spacing: 1.5px; margin: 4px 0 0;\">WELLNESS BRAND, 5-FIGURE MONTHLY VOLUME</p>",
