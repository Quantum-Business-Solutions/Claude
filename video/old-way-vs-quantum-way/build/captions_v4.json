[
 {
  "start": 0.08,
  "end": 1.13,
  "text": "I'm Bob."
 },
 {
  "start": 1.9,
  "end": 2.79,
  "text": "Bog Down Bob."
 },
 {
  "start": 3.76,
  "end": 6.31,
  "text": "I live in every sales team."
 },
 {
  "start": 9.33,
  "end": 10.03,
  "text": "Voicemail."
 },
 {
  "start": 10.45,
  "end": 12.42,
  "text": "Again, that's 11 today."
 },
 {
  "start": 14.84,
  "end": 16.31,
  "text": "There's gotta be a better way."
 },
 {
  "start": 16.84,
  "end": 19.49,
  "text": "I'm the voicemail you'll never hear back from."
 },
 {
  "start": 20.5,
  "end": 21.81,
  "text": "Keep dialing, buddy."
 },
 {
  "start": 23.56,
  "end": 24.45,
  "text": "Perfect."
 },
 {
  "start": 25.04,
  "end": 26.11,
  "text": "Tuesday at 10."
 },
 {
  "start": 26.5,
  "end": 27.29,
  "text": "See you then."
 },
 {
  "start": 28.6,
  "end": 29.79,
  "text": "Hi Mark, it's Maya."
 },
 {
  "start": 36.0,
  "end": 39.22,
  "text": "How have you talked to 11 people in 66 minutes?"
 },
 {
  "start": 39.22,
  "end": 42.45,
  "text": "I can't get anyone on the phone."
 },
 {
  "start": 43.38,
  "end": 45.01,
  "text": "You haven't heard of ConnectAndSell?"
 },
 {
  "start": 45.42,
  "end": 47.67,
  "text": "A week of prospecting in four hours."
 },
 {
  "start": 51.64,
  "end": 54.03,
  "text": "Three hours on one account,"
 },
 {
  "start": 54.3,
  "end": 55.85,
  "text": "and I still don't know who signs."
 },
 {
  "start": 57.0,
  "end": 58.83,
  "text": "Only three more hours, champ."
 },
 {
  "start": 67.67,
  "end": 68.37,
  "text": "Done."
 },
 {
  "start": 68.79,
  "end": 69.62,
  "text": "Three seconds."
 },
 {
  "start": 73.78,
  "end": 74.87,
  "text": "Who signs at Riverside?"
 },
 {
  "start": 76.0,
  "end": 77.89,
  "text": "Dr. Reyes. Dana recommends."
 },
 {
  "start": 78.46,
  "end": 79.16,
  "text": "Perfect."
 },
 {
  "start": 80.36,
  "end": 81.06,
  "text": "Oat milk,"
 },
 {
  "start": 81.3,
  "end": 82.15,
  "text": "two shots."
 },
 {
  "start": 82.56,
  "end": 83.49,
  "text": "You're the best."
 },
 {
  "start": 86.43,
  "end": 88.22,
  "text": "Rick, what's in your pipeline?"
 },
 {
  "start": 90.83,
  "end": 93.08,
  "text": "It's mostly in my head."
 },
 {
  "start": 94.11,
  "end": 94.81,
  "text": "Maya?"
 },
 {
  "start": 96.01,
  "end": 96.78,
  "text": "Twelve deals,"
 },
 {
  "start": 97.29,
  "end": 98.36,
  "text": "three closing this week."
 },
 {
  "start": 98.41,
  "end": 99.4,
  "text": "It's all in HubSpot."
 },
 {
  "start": 99.91,
  "end": 101.0,
  "text": "Now that's a pipeline."
 },
 {
  "start": 104.94,
  "end": 108.31,
  "text": "We have three locations, and the copiers keep going down."
 },
 {
  "start": 111.63,
  "end": 112.9,
  "text": "Sorry, can you repeat that?"
 },
 {
  "start": 113.71,
  "end": 115.17,
  "text": "Mind if I let an AI take"
 },
 {
  "start": 115.17,
  "end": 118.12,
  "text": "the note so I can give you my full attention?"
 },
 {
  "start": 119.17,
  "end": 119.88,
  "text": "Please."
 },
 {
  "start": 127.41,
  "end": 130.76,
  "text": "Hi, just following up on my last email."
 },
 {
  "start": 131.45,
  "end": 132.38,
  "text": "Ninth time today."
 },
 {
  "start": 133.49,
  "end": 135.04,
  "text": "You forgot to change the name."
 },
 {
  "start": 142.9,
  "end": 143.81,
  "text": "He'll remember."
 },
 {
  "start": 145.12,
  "end": 145.82,
  "text": "Probably."
 },
 {
  "start": 147.36,
  "end": 148.49,
  "text": "They already replied?"
 },
 {
  "start": 150.58,
  "end": 152.15,
  "text": "Follow-up went out at 9:02."
 },
 {
  "start": 160.36,
  "end": 161.51,
  "text": "I'll enter that later."
 },
 {
  "start": 163.34,
  "end": 164.39,
  "text": "He won't."
 },
 {
  "start": 165.9,
  "end": 167.56,
  "text": "Claude, log my meeting with Dana, send"
 },
 {
  "start": 167.56,
  "end": 169.91,
  "text": "her the recap, and set a follow-up for Tuesday."
 },
 {
  "start": 176.82,
  "end": 177.52,
  "text": "Done."
 },
 {
  "start": 182.18,
  "end": 183.9,
  "text": "I wish I'd done a better job tracking"
 },
 {
  "start": 183.9,
  "end": 185.24,
  "text": "contract end dates."
 },
 {
  "start": 185.24,
  "end": 191.17,
  "text": "I'm the file named Final Final Version 3."
 },
 {
  "start": 195.83,
  "end": 197.32,
  "text": "I jammed it."
 },
 {
  "start": 197.35,
  "end": 198.26,
  "text": "You're welcome."
 },
 {
  "start": 199.65,
  "end": 203.18,
  "text": "I ran every past engagement through Quantum's AI Lead Finder."
 },
 {
  "start": 203.23,
  "end": 206.44,
  "text": "2,500 competitive contracts coming up."
 },
 {
  "start": 216.5,
  "end": 217.2,
  "text": "Next."
 },
 {
  "start": 219.75,
  "end": 221.16,
  "text": "Okay, okay."
 },
 {
  "start": 221.95,
  "end": 222.9,
  "text": "Thank you."
 },
 {
  "start": 223.33,
  "end": 224.26,
  "text": "Hey, hon."
 },
 {
  "start": 225.69,
  "end": 227.4,
  "text": "It's gonna be another late night."
 },
 {
  "start": 229.09,
  "end": 232.6,
  "text": "I'm the 200 unread emails."
 },
 {
  "start": 237.29,
  "end": 238.06,
  "text": "No problem."
 },
 {
  "start": 239.05,
  "end": 240.92,
  "text": "I'll get my team on it right away."
 },
 {
  "start": 246.28,
  "end": 247.05,
  "text": "Wanna grab dinner?"
 },
 {
  "start": 249.78,
  "end": 250.2,
  "text": "Yeah."
 },
 {
  "start": 250.2,
  "end": 252.13,
  "text": "I think they've got it from here."
 },
 {
  "start": 256.31,
  "end": 257.74,
  "text": "Honey, it's Saturday."
 },
 {
  "start": 257.81,
  "end": 259.16,
  "text": "The kids have a game today."
 },
 {
  "start": 260.37,
  "end": 261.31,
  "text": "I know, I know."
 },
 {
  "start": 261.31,
  "end": 262.01,
  "text": "I'm coming."
 },
 {
  "start": 264.76,
  "end": 265.91,
  "text": "Not so fast."
 },
 {
  "start": 266.32,
  "end": 267.39,
  "text": "You're with me today."
 },
 {
  "start": 272.5,
  "end": 273.89,
  "text": "I can't do this anymore."
 },
 {
  "start": 275.68,
  "end": 278.51,
  "text": "But it's always been us."
 },
 {
  "start": 278.8,
  "end": 280.97,
  "text": "But I knew your dad."
 },
 {
  "start": 281.96,
  "end": 283.29,
  "text": "Dad, who's that?"
 },
 {
  "start": 284.24,
  "end": 286.17,
  "text": "That's our good friend Bog Down Bob."
 },
 {
  "start": 286.78,
  "end": 288.38,
  "text": "If you're lucky, you'll get to know"
 },
 {
  "start": 288.38,
  "end": 289.65,
  "text": "him as well as I have."
 },
 {
  "start": 289.98,
  "end": 291.95,
  "text": "He's the one who introduced us."
 },
 {
  "start": 292.16,
  "end": 295.31,
  "text": "He wanted us to have the exact same relationship."
 },
 {
  "start": 296.14,
  "end": 298.25,
  "text": "Remember the fax machine?"
 },
 {
  "start": 299.88,
  "end": 300.91,
  "text": "Good times."
 },
 {
  "start": 303.43,
  "end": 304.38,
  "text": "Wait."
 },
 {
  "start": 305.05,
  "end": 306.42,
  "text": "Don't go."
 },
 {
  "start": 307.15,
  "end": 308.44,
  "text": "We had something."
 },
 {
  "start": 309.09,
  "end": 310.42,
  "text": "Welcome to the team, Rick."
 },
 {
  "start": 311.11,
  "end": 314.1,
  "text": "So, where's the Done button?"
 },
 {
  "start": 318.25,
  "end": 318.95,
  "text": "Done."
 },
 {
  "start": 321.98,
  "end": 322.93,
  "text": "Anybody?"
 },
 {
  "start": 323.7,
  "end": 326.69,
  "text": "Anybody need some data entry?"
 },
 {
  "start": 332.52,
  "end": 334.77,
  "text": "Honey, where's Bog Down Bob?"
 },
 {
  "start": 335.7,
  "end": 337.84,
  "text": "I don't think we'll be seeing much of him anymore."
 },
 {
  "start": 337.89,
  "end": 341.56,
  "text": "Daddy, you made it!"
 },
 {
  "start": 343.0,
  "end": 343.91,
  "text": "Same job."
 },
 {
  "start": 344.74,
  "end": 345.49,
  "text": "Same hours."
 },
 {
  "start": 346.02,
  "end": 346.93,
  "text": "Different system."
 },
 {
  "start": 351.6,
  "end": 352.39,
  "text": "Hi, I'm Bob."
 },
 {
  "start": 352.7,
  "end": 354.29,
  "text": "Got any manual processes?"
 },
 {
  "start": 357.1,
  "end": 358.71,
  "text": "I'll see myself out."
 },
 {
  "start": 362.08,
  "end": 363.87,
  "text": "Hey, I'm available now."
 },
 {
  "start": 364.18,
  "end": 364.88,
  "text": "Pass."
 },
 {
  "start": 364.92,
  "end": 365.73,
  "text": "We use Quantum."
 },
 {
  "start": 369.32,
  "end": 371.75,
  "text": "Are you letting Bob hang out in your organization?"
 }
]