[
 {
  "start": 0.08,
  "end": 1.13,
  "text": "I'm Bob."
 },
 {
  "start": 1.9,
  "end": 2.79,
  "text": "Bog Down Bob."
 },
 {
  "start": 3.76,
  "end": 6.31,
  "text": "I live in every sales team."
 },
 {
  "start": 9.33,
  "end": 9.94,
  "text": "Voicemail."
 },
 {
  "start": 10.45,
  "end": 12.42,
  "text": "Again, that's 11 today."
 },
 {
  "start": 14.84,
  "end": 16.31,
  "text": "There's gotta be a better way."
 },
 {
  "start": 16.84,
  "end": 18.9,
  "text": "I'm the voicemail you'll never hear back"
 },
 {
  "start": 18.9,
  "end": 19.49,
  "text": "from."
 },
 {
  "start": 20.5,
  "end": 21.81,
  "text": "Keep dialing, buddy."
 },
 {
  "start": 23.56,
  "end": 24.45,
  "text": "Perfect."
 },
 {
  "start": 25.04,
  "end": 26.11,
  "text": "Tuesday at 10."
 },
 {
  "start": 26.5,
  "end": 27.29,
  "text": "See you then."
 },
 {
  "start": 28.6,
  "end": 29.79,
  "text": "Hi Mark, it's Maya."
 },
 {
  "start": 36.0,
  "end": 37.92,
  "text": "How have you talked to 11 people"
 },
 {
  "start": 37.92,
  "end": 39.22,
  "text": "in 66 minutes?"
 },
 {
  "start": 39.22,
  "end": 41.66,
  "text": "I can't get anyone on"
 },
 {
  "start": 41.66,
  "end": 42.45,
  "text": "the phone."
 },
 {
  "start": 43.38,
  "end": 45.01,
  "text": "You haven't heard of ConnectAndSell?"
 },
 {
  "start": 45.42,
  "end": 47.67,
  "text": "A week of prospecting in four hours."
 },
 {
  "start": 51.64,
  "end": 54.03,
  "text": "Three hours on one account,"
 },
 {
  "start": 54.3,
  "end": 55.85,
  "text": "and I still don't know who signs."
 },
 {
  "start": 57.0,
  "end": 58.83,
  "text": "Only three more hours, champ."
 },
 {
  "start": 67.67,
  "end": 68.16,
  "text": "Done."
 },
 {
  "start": 68.79,
  "end": 69.62,
  "text": "Three seconds."
 },
 {
  "start": 73.78,
  "end": 74.87,
  "text": "Who signs at Riverside?"
 },
 {
  "start": 76.0,
  "end": 76.85,
  "text": "Dr. Reyes,"
 },
 {
  "start": 77.32,
  "end": 77.89,
  "text": "Dana recommends."
 },
 {
  "start": 78.46,
  "end": 78.99,
  "text": "Perfect."
 },
 {
  "start": 80.36,
  "end": 80.99,
  "text": "Oat milk,"
 },
 {
  "start": 81.3,
  "end": 82.15,
  "text": "two shots."
 },
 {
  "start": 82.56,
  "end": 83.49,
  "text": "You're the best."
 },
 {
  "start": 86.43,
  "end": 88.22,
  "text": "Rick, what's in your pipeline?"
 },
 {
  "start": 90.83,
  "end": 93.08,
  "text": "It's mostly in my head."
 },
 {
  "start": 94.11,
  "end": 94.4,
  "text": "Maya?"
 },
 {
  "start": 96.01,
  "end": 96.78,
  "text": "Twelve deals,"
 },
 {
  "start": 97.27,
  "end": 98.36,
  "text": "three closing this week."
 },
 {
  "start": 98.39,
  "end": 99.4,
  "text": "It's all in HubSpot."
 },
 {
  "start": 99.89,
  "end": 101.0,
  "text": "Now that's a pipeline."
 },
 {
  "start": 104.94,
  "end": 107.24,
  "text": "We have three locations, and the copiers"
 },
 {
  "start": 107.24,
  "end": 108.31,
  "text": "keep going down."
 },
 {
  "start": 111.63,
  "end": 112.9,
  "text": "Sorry, can you repeat that?"
 },
 {
  "start": 113.71,
  "end": 115.17,
  "text": "Mind if I let an AI take"
 },
 {
  "start": 115.17,
  "end": 116.83,
  "text": "the note so I can give you"
 },
 {
  "start": 116.83,
  "end": 118.12,
  "text": "my full attention?"
 },
 {
  "start": 119.17,
  "end": 119.88,
  "text": "Please."
 },
 {
  "start": 131.3,
  "end": 132.39,
  "text": "He'll remember."
 },
 {
  "start": 133.66,
  "end": 134.33,
  "text": "Probably."
 },
 {
  "start": 135.86,
  "end": 136.99,
  "text": "They already replied?"
 },
 {
  "start": 139.22,
  "end": 140.67,
  "text": "Follow-up went out at 9:02."
 },
 {
  "start": 145.13,
  "end": 146.22,
  "text": "I'll enter that later."
 },
 {
  "start": 148.21,
  "end": 149.3,
  "text": "He won't."
 },
 {
  "start": 150.85,
  "end": 152.27,
  "text": "Claude, log my meeting with Dana, send"
 },
 {
  "start": 152.27,
  "end": 153.63,
  "text": "her the recap, and set a follow"
 },
 {
  "start": 153.63,
  "end": 154.62,
  "text": "-up for Tuesday."
 },
 {
  "start": 161.53,
  "end": 161.96,
  "text": "Done."
 },
 {
  "start": 166.8,
  "end": 168.18,
  "text": "I wish I'd done a better job"
 },
 {
  "start": 168.18,
  "end": 169.68,
  "text": "tracking contract end dates."
 },
 {
  "start": 169.68,
  "end": 171.82,
  "text": "I'm the file named"
 },
 {
  "start": 171.82,
  "end": 173.9,
  "text": "Final Final"
 },
 {
  "start": 173.9,
  "end": 175.85,
  "text": "Version 3."
 },
 {
  "start": 180.61,
  "end": 181.96,
  "text": "I jammed it."
 },
 {
  "start": 182.13,
  "end": 182.96,
  "text": "You're welcome."
 },
 {
  "start": 184.35,
  "end": 186.33,
  "text": "I ran every past engagement through Quantum's"
 },
 {
  "start": 186.33,
  "end": 187.8,
  "text": "AI Lead Finder."
 },
 {
  "start": 187.93,
  "end": 190.31,
  "text": "2,500 competitive contracts coming"
 },
 {
  "start": 190.31,
  "end": 191.18,
  "text": "up."
 },
 {
  "start": 201.22,
  "end": 201.61,
  "text": "Next."
 },
 {
  "start": 204.44,
  "end": 205.87,
  "text": "Okay, okay."
 },
 {
  "start": 206.54,
  "end": 207.71,
  "text": "Thank you."
 },
 {
  "start": 208.38,
  "end": 208.95,
  "text": "Hey, hon."
 },
 {
  "start": 210.38,
  "end": 212.11,
  "text": "It's going to be another late night."
 },
 {
  "start": 213.62,
  "end": 215.18,
  "text": "I'm the 200"
 },
 {
  "start": 215.18,
  "end": 217.39,
  "text": "unread emails."
 },
 {
  "start": 222.06,
  "end": 222.83,
  "text": "No problem."
 },
 {
  "start": 223.72,
  "end": 225.06,
  "text": "I'll get my team on it right"
 },
 {
  "start": 225.06,
  "end": 225.65,
  "text": "away."
 },
 {
  "start": 230.99,
  "end": 231.74,
  "text": "Want to grab dinner?"
 },
 {
  "start": 233.25,
  "end": 233.94,
  "text": "Yeah."
 },
 {
  "start": 234.89,
  "end": 236.82,
  "text": "I think they've got it from here."
 },
 {
  "start": 241.02,
  "end": 242.43,
  "text": "Honey, it's Saturday."
 },
 {
  "start": 242.52,
  "end": 243.85,
  "text": "The kids have a game today."
 },
 {
  "start": 245.06,
  "end": 246.55,
  "text": "I know, I know, I'm coming."
 },
 {
  "start": 249.48,
  "end": 250.59,
  "text": "Not so fast."
 },
 {
  "start": 250.9,
  "end": 251.82,
  "text": "You're with me today."
 },
 {
  "start": 251.82,
  "end": 252.75,
  "text": "I"
 },
 {
  "start": 257.17,
  "end": 258.51,
  "text": "can't do this anymore,"
 },
 {
  "start": 258.51,
  "end": 259.85,
  "text": "but"
 },
 {
  "start": 259.85,
  "end": 262.45,
  "text": "it's always been"
 },
 {
  "start": 262.45,
  "end": 263.24,
  "text": "us."
 },
 {
  "start": 263.59,
  "end": 265.66,
  "text": "But I knew your dad."
 },
 {
  "start": 266.67,
  "end": 268.02,
  "text": "Dad, who's that?"
 },
 {
  "start": 269.01,
  "end": 270.88,
  "text": "That's our good friend Bog Down Bob."
 },
 {
  "start": 271.51,
  "end": 273.07,
  "text": "If you're lucky, you'll get to know"
 },
 {
  "start": 273.07,
  "end": 274.34,
  "text": "him as well as I have."
 },
 {
  "start": 274.65,
  "end": 276.66,
  "text": "He's the one who introduced us."
 },
 {
  "start": 276.91,
  "end": 278.57,
  "text": "He wanted us to have the exact"
 },
 {
  "start": 278.57,
  "end": 280.0,
  "text": "same relationship."
 },
 {
  "start": 281.09,
  "end": 282.92,
  "text": "Remember the fax machine?"
 },
 {
  "start": 284.43,
  "end": 285.33,
  "text": "Good times."
 },
 {
  "start": 285.33,
  "end": 286.94,
  "text": "Wait."
 },
 {
  "start": 289.64,
  "end": 291.09,
  "text": "Don't go."
 },
 {
  "start": 291.84,
  "end": 293.13,
  "text": "We had something."
 },
 {
  "start": 293.9,
  "end": 295.15,
  "text": "Welcome to the team, Rick."
 },
 {
  "start": 295.84,
  "end": 296.45,
  "text": "So,"
 },
 {
  "start": 297.38,
  "end": 298.81,
  "text": "where's the Done button?"
 },
 {
  "start": 302.92,
  "end": 303.39,
  "text": "Done."
 },
 {
  "start": 306.8,
  "end": 307.61,
  "text": "Anybody?"
 },
 {
  "start": 308.4,
  "end": 310.68,
  "text": "Anybody need some data"
 },
 {
  "start": 310.68,
  "end": 311.39,
  "text": "entry?"
 },
 {
  "start": 317.3,
  "end": 317.75,
  "text": "Honey,"
 },
 {
  "start": 318.4,
  "end": 319.47,
  "text": "where's Bog Down Bob?"
 },
 {
  "start": 320.34,
  "end": 321.96,
  "text": "I don't think we'll be seeing much"
 },
 {
  "start": 321.96,
  "end": 322.81,
  "text": "of him anymore."
 },
 {
  "start": 324.49,
  "end": 325.04,
  "text": "Daddy!"
 },
 {
  "start": 327.66,
  "end": 328.59,
  "text": "Same job,"
 },
 {
  "start": 329.14,
  "end": 330.23,
  "text": "same hours,"
 },
 {
  "start": 330.78,
  "end": 331.36,
  "text": "different system."
 },
 {
  "start": 331.36,
  "end": 332.53,
  "text": "Hi,"
 },
 {
  "start": 336.43,
  "end": 337.12,
  "text": "I'm Bob."
 },
 {
  "start": 337.45,
  "end": 339.02,
  "text": "Got any manual processes?"
 },
 {
  "start": 341.54,
  "end": 343.41,
  "text": "I'll see myself out."
 },
 {
  "start": 346.72,
  "end": 348.57,
  "text": "Hey, I'm available now."
 },
 {
  "start": 348.92,
  "end": 349.27,
  "text": "Pass."
 },
 {
  "start": 349.7,
  "end": 350.43,
  "text": "We use Quantum."
 },
 {
  "start": 354.08,
  "end": 355.68,
  "text": "Are you letting Bob hang out in"
 },
 {
  "start": 355.68,
  "end": 356.43,
  "text": "your organization?"
 }
]